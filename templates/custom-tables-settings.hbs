<div class="custom-tables-settings-body">

    <div class="config-card">
        <h3><i class="fas fa-dice-d20"></i> {{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.heading"}}</h3>

        <p class="dqa-ct-hint">
            {{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.hint"}}}
        </p>

        <div class="dqa-drop-zone">
            <i class="fas fa-dice-d20"></i>
            <span>{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.dropZone"}}</span>
        </div>

        <ol class="dqa-table-list">
            {{#each tables}}
            <li class="dqa-table-row {{#if this.missing}}dqa-missing{{/if}}">
                <div class="dqa-table-info">
                    <span class="dqa-table-name">{{this.label}}</span>
                    <span class="dqa-table-source">
                        {{#if this.missing}}{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.missing"}}{{else}}{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.entries" count=this.results}}{{/if}}
                    </span>
                </div>
                <button type="button" class="dqa-icon-btn" data-action="removeTable" data-uuid="{{this.uuid}}"
                        data-tooltip="{{localize "DH_QUICKACTIONS.COMMON.remove"}}" aria-label="{{localize "DH_QUICKACTIONS.COMMON.removeNamed" name=this.label}}">
                    <i class="fas fa-trash"></i>
                </button>
            </li>
            {{/each}}

            {{#unless hasTables}}
            <li class="dqa-empty">{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.none"}}</li>
            {{/unless}}
        </ol>

        <button type="button" class="reset-btn" data-action="clearTables" {{#unless hasTables}}disabled{{/unless}}>
            <i class="fas fa-trash"></i> {{localize "DH_QUICKACTIONS.COMMON.clearAll"}}
        </button>
    </div>

    <div class="config-card">
        <h3><i class="fas fa-circle-info"></i> {{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.beforeHeading"}}</h3>

        <p class="field-hint">
            {{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.noteAccess"}}}
        </p>
        <p class="field-hint">
            {{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.noteItems"}}}
        </p>
        <p class="field-hint">
            {{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.settings.noteIndependent"}}}
        </p>
    </div>

</div>
