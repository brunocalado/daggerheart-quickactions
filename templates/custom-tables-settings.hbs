<div class="custom-tables-settings-body">

    <div class="config-card">
        <h3><i class="fas fa-dice-d20"></i> {{localize "DHQA.CustomTablesSettings.CustomTables"}}</h3>

        <p class="dqa-ct-hint">
            {{localize "DHQA.CustomTablesSettings.DragRollTablesHereFrom"}} <strong>{{localize "DHQA.CustomTablesSettings.QuickactionsCustomtables"}}</strong>.
        </p>

        <div class="dqa-drop-zone">
            <i class="fas fa-dice-d20"></i>
            <span>{{localize "DHQA.CustomTablesSettings.DropARollableTableHere"}}</span>
        </div>

        <ol class="dqa-table-list">
            {{#each tables}}
            <li class="dqa-table-row {{#if this.missing}}dqa-missing{{/if}}">
                <div class="dqa-table-info">
                    <span class="dqa-table-name">{{this.label}}</span>
                    <span class="dqa-table-source">
                        {{#if this.missing}}{{localize "DHQA.CustomTablesSettings.Missing"}}{{else}}{{localize "DHQA.CustomTablesSettings.Entries" n=this.results}}{{/if}}
                    </span>
                </div>
                <button type="button" class="dqa-icon-btn" data-action="removeTable" data-uuid="{{this.uuid}}"
                        data-tooltip="{{localize 'DHQA.CustomTablesSettings.Remove'}}" aria-label="{{localize "DHQA.CustomTablesSettings.RemoveLabel" label=this.label}}">
                    <i class="fas fa-trash"></i>
                </button>
            </li>
            {{/each}}

            {{#unless hasTables}}
            <li class="dqa-empty">{{localize "DHQA.CustomTablesSettings.NoTablesConfiguredYet"}}</li>
            {{/unless}}
        </ol>

        <button type="button" class="reset-btn" data-action="clearTables" {{#unless hasTables}}disabled{{/unless}}>
            <i class="fas fa-trash"></i> {{localize "DHQA.CustomTablesSettings.ClearAll"}}
        </button>
    </div>

    <div class="config-card">
        <h3><i class="fas fa-circle-info"></i> {{localize "DHQA.CustomTablesSettings.BeforeYouStart"}}</h3>

        <p class="field-hint">
            <strong>{{localize "DHQA.CustomTablesSettings.PlayersNeedToSeeThe"}}</strong> {{localize "DHQA.CustomTablesSettings.ARollTableCreatedIn"}} <em>{{localize "DHQA.CustomTablesSettings.Observer"}}</em> {{localize "DHQA.CustomTablesSettings.AndDoTheSameFor"}}
        </p>
        <p class="field-hint">
            <strong>{{localize "DHQA.CustomTablesSettings.ItemsOnly"}}</strong> {{localize "DHQA.CustomTablesSettings.ResultsAreHandedToThe"}}
        </p>
        <p class="field-hint">
            <strong>{{localize "DHQA.CustomTablesSettings.EveryDrawIsIndependent"}}</strong> {{localize "DHQA.CustomTablesSettings.ATableSetToDraw"}}
        </p>
    </div>

</div>
