<div class="dqa-ui-wrapper">

    <p class="dqa-ui-intro">
        {{localize "DHQA.UiSettings.WorldWideInterfaceChangesMade"}}
    </p>

    <fieldset class="dqa-ui-section">
        <legend><i class="fas fa-skull"></i> {{localize "DHQA.UiSettings.DaggerheartSidebarMenu"}}</legend>

        <div class="dqa-ui-row">
            <label for="dqa-menu-enhancements">{{localize "DHQA.UiSettings.MenuEnhancements"}}</label>
            <input type="checkbox" id="dqa-menu-enhancements" class="dh-toggle" name="menuEnhancements"
                   {{#if menuEnhancements}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{localize "DHQA.UiSettings.TurnsOffEverythingThisModule"}} <strong>{{localize "DHQA.UiSettings.QuickActions"}}</strong>
            {{localize "DHQA.UiSettings.SectionStaysInTheMenu"}}
        </p>
    </fieldset>

    <fieldset class="dqa-ui-section">
        <legend><i class="fas fa-chess-pawn"></i> {{localize "DHQA.UiSettings.Tokens"}}</legend>

        <div class="dqa-ui-row">
            <label for="dqa-token-tooltip">{{localize "DHQA.UiSettings.TokenHoverTooltip"}}</label>
            <input type="checkbox" id="dqa-token-tooltip" class="dh-toggle" name="tokenTooltip"
                   {{#if tokenTooltip}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{localize "DHQA.UiSettings.ShowsAStatSummaryTooltip"}} <strong>{{localize "DHQA.UiSettings.TokenTooltipSize"}}</strong> {{localize "DHQA.UiSettings.InTheModuleSettingsList"}}
        </p>

        <div class="dqa-ui-row">
            <label for="dqa-hope-bar">{{localize "DHQA.UiSettings.TokenHopeBar"}}</label>
            <input type="checkbox" id="dqa-hope-bar" class="dh-toggle" name="hopeBar"
                   {{#if hopeBar}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{localize "DHQA.UiSettings.DrawsARowOfHope"}}
        </p>
    </fieldset>

    <fieldset class="dqa-ui-section">
        <legend><i class="fas fa-address-card"></i> {{localize "DHQA.UiSettings.CharacterSheet"}}</legend>

        <div class="dqa-ui-row">
            <label for="dqa-hide-biography">{{localize "DHQA.UiSettings.HideBiographyTab"}}</label>
            <input type="checkbox" id="dqa-hide-biography" class="dh-toggle" name="hideBiography"
                   {{#if hideBiography}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{localize "DHQA.UiSettings.HidesTheBiographyTabOn"}}
        </p>
    </fieldset>

</div>
