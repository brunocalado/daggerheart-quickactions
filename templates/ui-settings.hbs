<div class="dqa-ui-wrapper">

    <p class="dqa-ui-intro">
        {{localize "DH_QUICKACTIONS.INTERFACE.intro"}}
    </p>

    <fieldset class="dqa-ui-section">
        <legend><i class="fas fa-skull"></i> {{localize "DH_QUICKACTIONS.INTERFACE.menuLegend"}}</legend>

        <div class="dqa-ui-row">
            <label for="dqa-menu-enhancements">{{localize "DH_QUICKACTIONS.INTERFACE.menuLabel"}}</label>
            <input type="checkbox" id="dqa-menu-enhancements" class="dh-toggle" name="menuEnhancements"
                   {{#if menuEnhancements}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{{localize "DH_QUICKACTIONS.INTERFACE.menuHint"}}}
        </p>
    </fieldset>

    <fieldset class="dqa-ui-section">
        <legend><i class="fas fa-chess-pawn"></i> {{localize "DH_QUICKACTIONS.INTERFACE.tokensLegend"}}</legend>

        <div class="dqa-ui-row">
            <label for="dqa-token-tooltip">{{localize "DH_QUICKACTIONS.SETTINGS.tokenTooltip.name"}}</label>
            <input type="checkbox" id="dqa-token-tooltip" class="dh-toggle" name="tokenTooltip"
                   {{#if tokenTooltip}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{{localize "DH_QUICKACTIONS.INTERFACE.tooltipHint"}}}
        </p>

        <div class="dqa-ui-row">
            <label for="dqa-hope-bar">{{localize "DH_QUICKACTIONS.SETTINGS.hopeBarEnabled.name"}}</label>
            <input type="checkbox" id="dqa-hope-bar" class="dh-toggle" name="hopeBar"
                   {{#if hopeBar}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{localize "DH_QUICKACTIONS.INTERFACE.hopeHint"}}
        </p>
    </fieldset>

    <fieldset class="dqa-ui-section">
        <legend><i class="fas fa-sack"></i> {{localize "DH_QUICKACTIONS.INTERFACE.stashLegend"}}</legend>

        <div class="dqa-ui-row">
            <label for="dqa-transfer-log">{{localize "DH_QUICKACTIONS.SETTINGS.transferLog.name"}}</label>
            <input type="checkbox" id="dqa-transfer-log" class="dh-toggle" name="transferLog"
                   {{#if transferLog}}checked{{/if}}>
        </div>

        <p class="dqa-ui-hint">
            {{localize "DH_QUICKACTIONS.SETTINGS.transferLog.hint"}}
        </p>
    </fieldset>

</div>
