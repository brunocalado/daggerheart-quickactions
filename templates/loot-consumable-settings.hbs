<div class="loot-consumable-settings-body">

    <div class="config-card">
        <h3><i class="fas fa-treasure-chest"></i> {{{localize "DHQA.LootConsumableSettings.LootConsumableTables"}}}</h3>

        <div class="form-group">
            <label for="dh-qa-loot-source">{{localize "DHQA.LootConsumableSettings.TableSource"}}</label>
            <select id="dh-qa-loot-source" name="source">
                {{#each sources}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
            <p class="field-hint">
                {{localize "DHQA.LootConsumableSettings.WhichDaggerheartRollTablesThe"}}
                <strong>{{{localize "DHQA.LootConsumableSettings.CoreSetHopeFear"}}}</strong> {{{localize "DHQA.LootConsumableSettings.TheTwoBooksShareOne"}}}
            </p>
        </div>
    </div>

    <div class="config-card">
        <h3><i class="fas fa-coins"></i> {{localize "DHQA.LootConsumableSettings.CoinTierRanges"}}</h3>

        <div class="form-group">
            <label>{{localize "DHQA.LootConsumableSettings.Tier1"}}</label>
            <div class="tier-range">
                <input type="number" name="tier1-min" value="{{tiers.tier1.min}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Min'}}">
                <span class="range-sep">–</span>
                <input type="number" name="tier1-max" value="{{tiers.tier1.max}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Max'}}">
                <span class="range-unit">{{localize "DHQA.LootConsumableSettings.Coins"}}</span>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "DHQA.LootConsumableSettings.Tier2"}}</label>
            <div class="tier-range">
                <input type="number" name="tier2-min" value="{{tiers.tier2.min}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Min'}}">
                <span class="range-sep">–</span>
                <input type="number" name="tier2-max" value="{{tiers.tier2.max}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Max'}}">
                <span class="range-unit">{{localize "DHQA.LootConsumableSettings.Coins"}}</span>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "DHQA.LootConsumableSettings.Tier3"}}</label>
            <div class="tier-range">
                <input type="number" name="tier3-min" value="{{tiers.tier3.min}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Min'}}">
                <span class="range-sep">–</span>
                <input type="number" name="tier3-max" value="{{tiers.tier3.max}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Max'}}">
                <span class="range-unit">{{localize "DHQA.LootConsumableSettings.Coins"}}</span>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "DHQA.LootConsumableSettings.Tier4"}}</label>
            <div class="tier-range">
                <input type="number" name="tier4-min" value="{{tiers.tier4.min}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Min'}}">
                <span class="range-sep">–</span>
                <input type="number" name="tier4-max" value="{{tiers.tier4.max}}" min="0" placeholder="{{localize 'DHQA.LootConsumableSettings.Max'}}">
                <span class="range-unit">{{localize "DHQA.LootConsumableSettings.Coins"}}</span>
            </div>
        </div>

        <button type="button" class="reset-btn">
            <i class="fas fa-undo"></i> {{localize "DHQA.LootConsumableSettings.ResetToDefaults"}}
        </button>
    </div>

    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="far fa-save"></i> {{localize "DHQA.LootConsumableSettings.SaveConfiguration"}}
        </button>
    </footer>

</div>
