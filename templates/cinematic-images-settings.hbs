<div class="dqa-ci-wrapper">
    <p class="dqa-ci-hint">
        {{{localize "DHQA.CinematicImagesSettings.PickAnImageForEach"}}}
    </p>

    <ol class="dqa-ci-list">
        {{#each rows}}
        <li class="dqa-ci-row">
            {{#if this.hasImage}}
            <img src="{{this.path}}" alt="{{this.label}}">
            {{else}}
            <div class="dqa-ci-placeholder"><i class="fas fa-image"></i></div>
            {{/if}}
            <div class="dqa-ci-info">
                <span class="dqa-ci-label">{{this.label}}</span>
                <span class="dqa-ci-path">{{#if this.hasImage}}{{this.path}}{{else}}{{localize "DHQA.CinematicImagesSettings.NoImage"}}{{/if}}</span>
            </div>
            <button type="button" class="dqa-icon-btn" data-action="browseImage" data-case="{{this.key}}"
                    data-tooltip="{{localize 'DHQA.CinematicImagesSettings.Browse'}}" aria-label="{{localize "DHQA.CinematicImagesSettings.BrowseFor" label=this.label}}">
                <i class="fas fa-folder-open"></i>
            </button>
            <button type="button" class="dqa-icon-btn" data-action="clearImage" data-case="{{this.key}}"
                    data-tooltip="{{localize 'DHQA.CinematicImagesSettings.Clear'}}" aria-label="{{localize "DHQA.CinematicImagesSettings.ClearFor" label=this.label}}" {{#unless this.hasImage}}disabled{{/unless}}>
                <i class="fas fa-trash"></i>
            </button>
        </li>
        {{/each}}
    </ol>

    <footer class="dqa-ci-footer">
        <button type="button" class="dqa-ci-footer-btn" data-action="resetDefaults"
                data-tooltip="{{localize 'DHQA.CinematicImagesSettings.RestoreTheIconThisModule'}}">
            <i class="fas fa-rotate-left"></i> {{localize "DHQA.CinematicImagesSettings.ResetToDefault"}}
        </button>
        <button type="button" class="dqa-ci-footer-btn dqa-ci-danger" data-action="clearAll"
                data-tooltip="{{localize 'DHQA.CinematicImagesSettings.BlankEveryCaseCinematicMode'}}">
            <i class="fas fa-trash"></i> {{localize "DHQA.CinematicImagesSettings.ClearAll"}}
        </button>
    </footer>
</div>
