<div class="dqa-ci-wrapper">
    <p class="dqa-ci-hint">
        {{localize "DH_QUICKACTIONS.CINEMATIC.settings.hint"}}
    </p>

    <ol class="dqa-ci-list">
        {{#each rows}}
        <li class="dqa-ci-row">
            {{#if this.hasImage}}
            <img src="{{this.path}}" alt="{{this.label}}">
            {{else}}
            <div class="dqa-ci-placeholder"><i class="fas fa-image"></i></div>
            {{/if}}
            <div class="dqa-ci-info">
                <span class="dqa-ci-label">{{this.label}}</span>
                <span class="dqa-ci-path">{{#if this.hasImage}}{{this.path}}{{else}}{{localize "DH_QUICKACTIONS.CINEMATIC.settings.noImage"}}{{/if}}</span>
            </div>
            <button type="button" class="dqa-icon-btn" data-action="browseImage" data-case="{{this.key}}"
                    data-tooltip="{{localize "DH_QUICKACTIONS.CINEMATIC.settings.browse"}}" aria-label="{{localize "DH_QUICKACTIONS.CINEMATIC.settings.browseLabel" name=this.label}}">
                <i class="fas fa-folder-open"></i>
            </button>
            <button type="button" class="dqa-icon-btn" data-action="clearImage" data-case="{{this.key}}"
                    data-tooltip="{{localize "DH_QUICKACTIONS.CINEMATIC.settings.clear"}}" aria-label="{{localize "DH_QUICKACTIONS.CINEMATIC.settings.clearLabel" name=this.label}}" {{#unless this.hasImage}}disabled{{/unless}}>
                <i class="fas fa-trash"></i>
            </button>
        </li>
        {{/each}}
    </ol>

    <footer class="dqa-ci-footer">
        <button type="button" class="dqa-ci-footer-btn" data-action="resetDefaults"
                data-tooltip="{{localize "DH_QUICKACTIONS.CINEMATIC.settings.resetDefaultTooltip"}}">
            <i class="fas fa-rotate-left"></i> {{localize "DH_QUICKACTIONS.CINEMATIC.settings.resetDefault"}}
        </button>
        <button type="button" class="dqa-ci-footer-btn dqa-ci-danger" data-action="clearAll"
                data-tooltip="{{localize "DH_QUICKACTIONS.CINEMATIC.settings.clearAllTooltip"}}">
            <i class="fas fa-trash"></i> {{localize "DH_QUICKACTIONS.COMMON.clearAll"}}
        </button>
    </footer>
</div>
