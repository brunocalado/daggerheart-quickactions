<div class="dh-main-layout">
<style>
    /* Layout */
    .dh-main-layout { display: flex; gap: 15px; height: 100%; }
    .dh-left-col { flex: 1; display: flex; flex-direction: column; gap: 12px; }
    .dh-right-col { width: 220px; display: flex; flex-direction: column; gap: 5px; border-left: 1px solid #444; padding-left: 10px; max-height: 400px; }

    /* Existing Styles Adapted */
    .dh-rr-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .dh-rr-label { font-weight: bold; color: #C9A060; flex: 0 0 80px; text-align: right; padding-right: 5px; margin-bottom: 0; }
    .dh-rr-input { flex: 1; text-align: center; background: rgba(255,255,255,0.9); border: 1px solid #7a6e5d; padding: 5px; border-radius: 4px; color: #000000 !important; font-weight: bold; }
    
    .dh-trait-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 5px; }
    .dh-trait-grid button.full-width { grid-column: 1 / -1; }
    
    .dh-trait-btn { 
        background: #191919; 
        color: #ffffff; 
        border: 1px solid #666; 
        padding: 6px; 
        cursor: pointer; 
        border-radius: 4px; 
        font-size: 0.9em; 
        text-transform: uppercase; 
        transition: all 0.2s; 
    }
    .dh-trait-btn:hover { border-color: #C9A060; color: #C9A060; }
    .dh-trait-btn.active { background: #C9A060; color: #191919; border-color: #C9A060; font-weight: bold; box-shadow: 0 0 8px rgba(201, 160, 96, 0.4); }
    
    .dh-special-btn { font-weight: bold; border-width: 2px; }
    .dh-special-btn[data-special="hope"] { border-color: #FFD700; color: #FFD700; }
    .dh-special-btn[data-special="hope"].active, .dh-special-btn[data-special="hope"]:hover { background: #FFD700; color: #000; box-shadow: 0 0 8px #FFD700; }
    
    .dh-special-btn[data-special="fear"] { border-color: #800080; color: #b54ec4; }
    .dh-special-btn[data-special="fear"].active, .dh-special-btn[data-special="fear"]:hover { background: #800080; color: #fff; box-shadow: 0 0 8px #800080; }

    .dh-special-btn[data-special="loot"] { border-color: #2ecc71; color: #2ecc71; }
    .dh-special-btn[data-special="loot"].active, .dh-special-btn[data-special="loot"]:hover { background: #2ecc71; color: #000; box-shadow: 0 0 8px #2ecc71; }

    .dh-cb-row { display: flex; align-items: center; justify-content: space-around; background: rgba(0,0,0,0.2); padding: 8px 10px; border-radius: 4px; }
    /* Toggle sits at the end of the label so the switches line up down the row.
       The switch skin itself lives in styles/app-base.css (.dh-toggle). */
    .dh-cb-label { display: flex; align-items: center; gap: 10px; color: #e0e0e0; cursor: pointer; font-size: 0.95em; margin-bottom: 0; }
    .dh-sq-btn { width: 32px; height: 30px; padding: 0; border: 1px solid #555; background: #191919; color: #C9A060; cursor: pointer; font-weight: bold; display: flex; align-items: center; justify-content: center; border-radius: 4px; transition: background 0.2s; font-size: 0.9em; }
    .dh-sq-btn:hover { background: #C9A060; color: #191919; }
    .dh-sq-btn.active { background: #C9A060; color: #191919; border-color: #C9A060; }
    .dh-dc-wrapper { display: flex; align-items: center; gap: 4px; flex: 1; }

    /* Suggested labels panel — collapsed by default, expanded by the bulb button next to
       the Label field. `[hidden]` needs an explicit rule because `display: flex` below
       would otherwise beat the attribute's default `display: none`. */
    .dh-suggestions { display: flex; flex-direction: column; align-items: stretch; gap: 10px; background: rgba(0,0,0,0.25); border: 1px solid #444; border-radius: 4px; padding: 10px; max-height: 260px; overflow-y: auto; }
    .dh-suggestions[hidden] { display: none; }
    /* Trait heading stacks above its chips so both start flush against the panel's
       left edge — the labels are long enough that an indented column would wrap badly. */
    .dh-suggestion-group { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; }
    .dh-suggestion-trait { color: #C9A060; font-weight: bold; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.5px; text-align: left; }
    .dh-suggestion-chips { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 6px; width: 100%; }
    .dh-suggestion-chip { background: #191919; color: #e0e0e0; border: 1px solid #666; border-radius: 12px; padding: 3px 12px; font-size: 0.85em; line-height: 1.4; white-space: nowrap; cursor: pointer; transition: all 0.2s; }
    .dh-suggestion-chip:hover { background: #C9A060; color: #191919; border-color: #C9A060; }
    
    /* User Buttons (Right Column) */
    .dh-user-btn {
        background: #2b2b2b;
        color: #e0e0e0;
        border: 1px solid #555;
        padding: 8px;
        text-align: left;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.2s;
        font-weight: bold;
        font-size: 0.9em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
    }
    .dh-user-btn:hover {
        border-color: #C9A060;
        color: #C9A060;
    }
    .dh-user-btn.selected {
        background: #C9A060;
        color: #191919 !important;
        border-color: #C9A060;
    }
    .dh-user-btn.selected:hover {
        background: #b8893e;
        color: #191919 !important;
    }
    .dh-user-list { display: flex; flex-direction: column; gap: 5px; overflow-y: auto; flex: 1; min-height: 0; }
    .dh-send-btn {
        background: #C9A060;
        color: #191919;
        border: 2px solid #8a6d3b;
        padding: 10px;
        width: 100%;
        text-transform: uppercase;
        cursor: pointer;
        border-radius: 4px;
        font-weight: bold;
        font-size: 0.95em;
        transition: all 0.2s;
        margin-top: 8px;
        flex-shrink: 0;
    }
    .dh-send-btn:hover:not(:disabled) { background: #b8893e; box-shadow: 0 0 8px rgba(201, 160, 96, 0.5); }
    .dh-send-btn:disabled { background: #444; color: #666; border-color: #444; cursor: not-allowed; }

    .dh-btn-cancel { 
        background: transparent; 
        color: #e0e0e0; 
        border: 1px solid #777; 
        padding: 10px; 
        width: 100%; 
        text-transform: uppercase; 
        cursor: pointer; 
        border-radius: 4px; 
        transition: all 0.2s;
        margin-top: auto;
    }
    .dh-btn-cancel:hover { color: #fff; border-color: #fff; background: rgba(255,255,255,0.1); }
</style>

    <!-- LEFT COLUMN -->
    <div class="dh-left-col">
        <div class="dh-rr-row">
            <label class="dh-rr-label">Difficulty</label>
            <div class="dh-dc-wrapper">
                <button type="button" class="dh-sq-btn" data-action="mod-dc" data-value="-5">-5</button>
                <button type="button" class="dh-sq-btn" data-action="mod-dc" data-value="-2">-2</button>
                <button type="button" class="dh-sq-btn" data-action="mod-dc" data-value="-1">-1</button>
                <input type="number" name="difficulty" value="{{difficulty}}" class="dh-rr-input" placeholder="DC" style="width: 70px; flex: 0 0 70px;">
                <button type="button" class="dh-sq-btn" data-action="mod-dc" data-value="1">+1</button>
                <button type="button" class="dh-sq-btn" data-action="mod-dc" data-value="2">+2</button>
                <button type="button" class="dh-sq-btn" data-action="mod-dc" data-value="5">+5</button>
                <button type="button" class="dh-sq-btn" data-action="clear-dc" title="Clear Difficulty" style="margin-left: 5px; color: #ff6b6b; border-color: #ff6b6b;">
                    <i class="fas fa-eraser"></i>
                </button>
            </div>
        </div>
        
        <div>
            <label class="dh-rr-label" style="text-align: left; display:block;">Trait</label>
            <input type="hidden" name="trait" value="">
            <input type="hidden" name="specialRoll" value="">
            
            <div class="dh-trait-grid">
                <div style="grid-column: 1 / -1; display: flex; gap: 10px; margin-bottom: 2px;">
                    <button type="button" class="dh-trait-btn active" data-trait="" style="flex:1;">None</button>
                    <button type="button" class="dh-trait-btn dh-special-btn" data-special="hope" style="flex:1;">HOPE</button>
                    <button type="button" class="dh-trait-btn dh-special-btn" data-special="fear" style="flex:1;">FEAR</button>
                    <button type="button" class="dh-trait-btn dh-special-btn" data-special="loot" style="flex:1;">LOOT</button>
                </div>
                <button type="button" class="dh-trait-btn" data-trait="agility">Agility</button>
                <button type="button" class="dh-trait-btn" data-trait="strength">Strength</button>
                <button type="button" class="dh-trait-btn" data-trait="finesse">Finesse</button>
                <button type="button" class="dh-trait-btn" data-trait="instinct">Instinct</button>
                <button type="button" class="dh-trait-btn" data-trait="presence">Presence</button>
                <button type="button" class="dh-trait-btn" data-trait="knowledge">Knowledge</button>
            </div>
        </div>

        <div class="dh-cb-row">
            <label class="dh-cb-label">Advantage <input type="checkbox" class="dh-toggle" name="advantage"></label>
            <label class="dh-cb-label">Disadvantage <input type="checkbox" class="dh-toggle" name="disadvantage"></label>
            <label class="dh-cb-label">Reaction <input type="checkbox" class="dh-toggle" name="reaction"></label>
        </div>
        <div class="dh-cb-row">
            <label class="dh-cb-label">Grant Resources <input type="checkbox" class="dh-toggle" name="grantResources" checked></label>
            <label class="dh-cb-label" style="color: #ffaa44;">Cinematic Mode <input type="checkbox" class="dh-toggle" name="cinematicMode" {{#if cinematicMode}}checked{{/if}}></label>
        </div>
        
        <div class="dh-rr-row">
            <label class="dh-rr-label">Label</label>
            <input type="text" name="label" class="dh-rr-input" placeholder="Optional description...">
            <button type="button" class="dh-sq-btn" data-action="toggleSuggestions" aria-expanded="false"
                    title="Suggested labels" aria-label="Suggested labels">
                <i class="fas fa-lightbulb"></i>
            </button>
        </div>

        <div class="dh-suggestions" hidden>
            {{#each labelSuggestions}}
            <div class="dh-suggestion-group">
                <span class="dh-suggestion-trait">{{this.traitLabel}}</span>
                <div class="dh-suggestion-chips">
                    {{#each this.suggestions}}
                    <button type="button" class="dh-suggestion-chip" data-action="applySuggestion"
                            data-label="{{this.label}}" data-trait="{{../trait}}"
                            data-tooltip="{{this.hint}}">{{this.label}}</button>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>

        <button type="button" class="dh-btn-cancel" data-action="cancel">Cancel</button>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="dh-right-col">
        <div style="font-weight: bold; color: #C9A060; text-align: center; margin-bottom: 5px; text-transform: uppercase; font-size: 0.9em;">Send To</div>
        <div class="dh-user-list">
            <button type="button" class="dh-user-btn" data-action="toggleUser" data-target="all">All Players</button>
            {{#each connectedUsers}}
            <button type="button" class="dh-user-btn" data-action="toggleUser" data-target="{{this.id}}" style="--user-color: {{this.color}}; color: {{this.color}}" title="{{this.fullLabel}}">{{this.label}}</button>
            {{/each}}
        </div>
        <button type="button" class="dh-send-btn" data-action="roll" disabled>
            <i class="fas fa-paper-plane"></i> Send Roll
        </button>
    </div>
</div>