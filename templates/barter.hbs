{{!--
    Inline partials keep the two inventory panels identical: the left one is always the local
    actor, the right one is the party stash in party mode. Each tab and currency row carries its
    own `side` so a single set of actions can serve both panels.
--}}
{{#*inline "dqaBarterInventory"}}
<nav class="dqa-barter-tabs">
    {{#each tabs}}
    <button type="button" class="dqa-barter-tab {{#if this.active}}active{{/if}}"
            data-action="selectTab" data-side="{{this.side}}" data-tab="{{this.type}}">
        <i class="{{this.icon}}"></i> {{this.label}}
    </button>
    {{/each}}
</nav>

{{#each tabs}}
<div class="dqa-barter-grid {{#if this.active}}active{{/if}}" data-tab="{{this.type}}">
    {{#each this.items}}
    <div class="dqa-barter-tile {{#if this.selected}}selected{{/if}} {{#if this.unidentified}}unidentified{{/if}}"
         data-action="toggleItem" data-side="{{../side}}" data-item-id="{{this.id}}"
         data-item-uuid="{{this.uuid}}"
         data-tooltip="{{this.name}}" aria-label="{{this.name}}">
        <img src="{{this.img}}" alt="{{this.name}}">
        {{#if this.unidentified}}<i class="fa-solid fa-question dqa-barter-unknown"></i>{{/if}}
        {{#if this.stackable}}<span class="dqa-barter-owned">×{{this.owned}}</span>{{/if}}
        {{#if this.selected}}
        {{#if this.stackable}}
        <div class="dqa-barter-stepper">
            <button type="button" data-action="stepQuantity" data-side="{{../side}}"
                    data-item-id="{{this.id}}" data-delta="-1">−</button>
            <span>{{this.quantity}}</span>
            <button type="button" data-action="stepQuantity" data-side="{{../side}}"
                    data-item-id="{{this.id}}" data-delta="1">+</button>
        </div>
        {{/if}}
        <i class="fa-solid fa-check dqa-barter-check"></i>
        {{/if}}
    </div>
    {{else}}
    <p class="dqa-barter-empty">{{localize "DHQA.Barter.NoneAvailable" label=this.label}}</p>
    {{/each}}
</div>
{{/each}}
{{/inline}}

{{#*inline "dqaBarterGold"}}
<div class="dqa-barter-gold">
    {{#each gold}}
    <label class="dqa-barter-gold-entry" data-tooltip="{{localize "DHQA.Barter.OwnedAvailable" n=this.owned}}">
        <span class="dqa-barter-gold-label"><i class="{{this.icon}}"></i> {{this.label}}</span>
        <input type="number" class="dqa-barter-gold-input" min="0" max="{{this.owned}}" step="1"
               value="{{this.offered}}" data-side="{{this.side}}" data-currency="{{this.key}}"
               data-owned="{{this.owned}}">
        <span class="dqa-barter-gold-owned">/ {{this.owned}}</span>
    </label>
    {{/each}}
</div>
{{/inline}}

<div class="dqa-barter-layout">

    <!-- ============ LEFT: WHAT YOU OWN AND HAVE SELECTED ============ -->
    <section class="dqa-barter-side dqa-barter-mine">

        <header class="dqa-barter-header">
            <img class="dqa-barter-portrait" src="{{actorImg}}" alt="{{actorName}}">
            <div class="dqa-barter-heading">
                <span class="dqa-barter-title">{{mineTitle}}</span>
                <span class="dqa-barter-subtitle">{{actorName}}</span>
            </div>
            <span class="dqa-barter-badge">{{localize "DHQA.Barter.Selected" n=myOfferCount}}</span>
        </header>

        {{> dqaBarterInventory tabs=tabs}}

        {{#if myGold.length}}
        {{> dqaBarterGold gold=myGold}}
        {{/if}}

        <footer class="dqa-barter-footer">
            {{#if isParty}}
            <button type="button" class="dqa-barter-confirm" data-action="transfer"
                    {{#unless canTransfer}}disabled{{/unless}}>
                <i class="fa-solid fa-right-left"></i> {{localize "DHQA.Barter.CompleteTransfer"}}
            </button>
            {{else if isInitiator}}
            <button type="button" class="dqa-barter-confirm" data-action="approve"
                    {{#unless canApprove}}disabled{{/unless}}>
                <i class="fa-solid fa-handshake"></i> {{localize "DHQA.Barter.ApproveTrade"}}
            </button>
            {{else}}
            <button type="button" class="dqa-barter-confirm {{#if myLocked}}locked{{/if}}" data-action="toggleLock">
                {{#if myLocked}}
                <i class="fa-solid fa-lock"></i> {{localize "DHQA.Barter.OfferConfirmed"}}
                {{else}}
                <i class="fa-solid fa-check"></i> {{localize "DHQA.Barter.ConfirmOffer"}}
                {{/if}}
            </button>
            {{/if}}
            <button type="button" class="dqa-barter-cancel" data-action="cancel">{{localize "DHQA.Barter.Cancel"}}</button>
        </footer>
    </section>

    <!-- ============ RIGHT: PARTNER PICKER, PEER OFFER, OR PARTY STASH ============ -->
    <section class="dqa-barter-side dqa-barter-theirs">

        {{#if isDraft}}
        <header class="dqa-barter-header">
            <div class="dqa-barter-heading">
                <span class="dqa-barter-title">{{localize "DHQA.Barter.TradeWith"}}</span>
                <span class="dqa-barter-subtitle">{{localize "DHQA.Barter.PickAPartyStashOr"}}</span>
            </div>
        </header>

        <div class="dqa-barter-users">
            {{#if parties.length}}
            <span class="dqa-barter-group">{{localize "DHQA.Barter.Party"}}</span>
            {{#each parties}}
            <button type="button" class="dqa-barter-target {{#if this.selected}}selected{{/if}}"
                    data-action="selectTarget" data-target-type="party" data-target-id="{{this.uuid}}">
                <img src="{{this.img}}" alt="{{this.name}}">
                <span class="dqa-barter-target-names">
                    <strong>{{this.name}}</strong>
                    <span class="dqa-barter-target-sep">-</span>
                    <span class="dqa-barter-target-tag">{{localize "DHQA.Barter.PartyStash"}}</span>
                </span>
            </button>
            {{/each}}
            {{/if}}

            {{#if users.length}}
            <span class="dqa-barter-group">{{localize "DHQA.Barter.Players"}}</span>
            {{#each users}}
            <button type="button" class="dqa-barter-target {{#if this.selected}}selected{{/if}}"
                    data-action="selectTarget" data-target-type="user" data-target-id="{{this.id}}">
                <img src="{{this.actorImg}}" alt="{{this.actorName}}">
                <span class="dqa-barter-target-names">
                    <strong>{{this.actorName}}</strong>
                    <span class="dqa-barter-target-sep">-</span>
                    <span class="dqa-barter-target-user" style="color: {{this.color}};">{{this.name}}</span>
                </span>
            </button>
            {{/each}}
            {{/if}}

            {{#unless hasTargets}}
            <p class="dqa-barter-empty">{{localize "DHQA.Barter.NoPartyStashOrConnected"}}</p>
            {{/unless}}
        </div>

        <footer class="dqa-barter-footer">
            <button type="button" class="dqa-barter-start" data-action="startTrade"
                    {{#unless canStart}}disabled{{/unless}}>
                <i class="fa-solid fa-right-left"></i> {{localize "DHQA.Barter.StartTrade"}}
            </button>
        </footer>
        {{/if}}

        {{#if isPending}}
        <div class="dqa-barter-waiting">
            <i class="fa-solid fa-hourglass-half fa-fade"></i>
            <p>{{localize "DHQA.Barter.WaitingFor"}} <strong>{{peerName}}</strong> {{localize "DHQA.Barter.ToAccept"}}</p>
        </div>
        {{/if}}

        {{#if isParty}}
        <header class="dqa-barter-header">
            <img class="dqa-barter-portrait" src="{{partyImg}}" alt="{{partyName}}">
            <div class="dqa-barter-heading">
                <span class="dqa-barter-title">{{localize "DHQA.Barter.YouTake"}}</span>
                <span class="dqa-barter-subtitle">{{partyName}}</span>
            </div>
            <span class="dqa-barter-badge">{{localize "DHQA.Barter.Selected" n=partyTakeCount}}</span>
        </header>

        {{> dqaBarterInventory tabs=partyTabs}}

        {{#if partyGold.length}}
        {{> dqaBarterGold gold=partyGold}}
        {{/if}}

        <footer class="dqa-barter-footer">
            <p class="dqa-barter-status">{{localize "DHQA.Barter.PartyStashGiveAndTake"}}</p>
        </footer>
        {{/if}}

        {{#if isActive}}
        <header class="dqa-barter-header">
            <img class="dqa-barter-portrait" src="{{peerActorImg}}" alt="{{peerActorName}}">
            <div class="dqa-barter-heading">
                <span class="dqa-barter-title">{{peerActorName}}</span>
                <span class="dqa-barter-subtitle">{{peerName}}</span>
            </div>
            {{#if peerLocked}}
            <span class="dqa-barter-badge confirmed"><i class="fa-solid fa-lock"></i> {{localize "DHQA.Barter.Confirmed"}}</span>
            {{else}}
            <span class="dqa-barter-badge"><i class="fa-solid fa-pen"></i> {{localize "DHQA.Barter.Choosing"}}</span>
            {{/if}}
        </header>

        <div class="dqa-barter-peer-items">
            {{#each peerItems}}
            <div class="dqa-barter-tile offered {{#if this.unidentified}}unidentified{{/if}}"
                 data-item-uuid="{{this.uuid}}"
                 data-tooltip="{{this.name}}" aria-label="{{this.name}}">
                <img src="{{this.img}}" alt="{{this.name}}">
                {{#if this.unidentified}}<i class="fa-solid fa-question dqa-barter-unknown"></i>{{/if}}
                {{#if (gt this.quantity 1)}}<span class="dqa-barter-owned">×{{this.quantity}}</span>{{/if}}
            </div>
            {{/each}}
            {{#if peerEmpty}}
            <p class="dqa-barter-empty">{{localize "DHQA.Barter.NothingOfferedInReturnThis"}}</p>
            {{/if}}
        </div>

        {{#if peerGold.length}}
        <div class="dqa-barter-gold readonly">
            {{#each peerGold}}
            <span class="dqa-barter-gold-entry">
                <span class="dqa-barter-gold-label"><i class="{{this.icon}}"></i> {{this.label}}</span>
                <strong>{{this.amount}}</strong>
            </span>
            {{/each}}
        </div>
        {{/if}}

        <footer class="dqa-barter-footer">
            <p class="dqa-barter-status">
                {{#if isInitiator}}
                {{#if peerLocked}}{{localize "DHQA.Barter.PeerLockedApprove"}}
                {{else}}{{localize "DHQA.Barter.WaitingConfirm" name=peerName}}{{/if}}
                {{else}}
                {{#if myLocked}}{{localize "DHQA.Barter.WaitingApprove" name=peerName}}
                {{else}}{{localize "DHQA.Barter.AddSendBack"}}{{/if}}
                {{/if}}
            </p>
        </footer>
        {{/if}}

    </section>

</div>
