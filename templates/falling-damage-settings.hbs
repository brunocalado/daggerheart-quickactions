<div class="falling-damage-settings">

    <div class="config-card">
        <h3><i class="fas fa-skull-crossbones"></i> {{localize "DHQA.FallingDamageSettings.FallingDamageFormulas"}}</h3>

        <div class="form-group">
            <label>{{localize "DHQA.FallingDamageSettings.VeryCloseRange"}}</label>
            <input type="text" name="veryclose" value="{{formulas.veryclose}}" placeholder="{{localize 'DHQA.FallingDamageSettings.EG1d103'}}" maxlength="20">
            <span class="hint">{{localize "DHQA.FallingDamageSettings.DamageFormulaForVeryClose"}}</span>
        </div>

        <div class="form-group">
            <label>{{localize "DHQA.FallingDamageSettings.CloseRange"}}</label>
            <input type="text" name="close" value="{{formulas.close}}" placeholder="{{localize 'DHQA.FallingDamageSettings.EG1d205'}}" maxlength="20">
            <span class="hint">{{localize "DHQA.FallingDamageSettings.DamageFormulaForCloseFall"}}</span>
        </div>

        <div class="form-group">
            <label>{{localize "DHQA.FallingDamageSettings.FarVeryFarRange"}}</label>
            <input type="text" name="far" value="{{formulas.far}}" placeholder="{{localize 'DHQA.FallingDamageSettings.EG1d10015'}}" maxlength="20">
            <span class="hint">{{localize "DHQA.FallingDamageSettings.DamageFormulaForFarAnd"}}</span>
        </div>

        <div class="form-group">
            <label>{{localize "DHQA.FallingDamageSettings.Collision"}}</label>
            <input type="text" name="collision" value="{{formulas.collision}}" placeholder="{{localize 'DHQA.FallingDamageSettings.EG1d205'}}" maxlength="20">
            <span class="hint">{{localize "DHQA.FallingDamageSettings.DamageFormulaForCollisionDamage"}}</span>
        </div>

        <button type="button" class="reset-btn">
            <i class="fas fa-undo"></i> {{localize "DHQA.FallingDamageSettings.ResetToDefaults"}}
        </button>
    </div>

    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="far fa-save"></i> {{localize "DHQA.FallingDamageSettings.SaveConfiguration"}}
        </button>
    </footer>

</div>
