<div class="falling-damage-settings">

    <div class="config-card">
        <h3><i class="fas fa-skull-crossbones"></i> {{localize "DH_QUICKACTIONS.FALLING.settings.heading"}}</h3>

        <div class="form-group">
            <label>{{localize "DH_QUICKACTIONS.FALLING.settings.veryClose"}}</label>
            <input type="text" name="veryclose" value="{{formulas.veryclose}}" placeholder="{{localize "DH_QUICKACTIONS.FALLING.settings.placeholder" example="1d10+3"}}" maxlength="20">
            <span class="hint">{{localize "DH_QUICKACTIONS.FALLING.settings.veryCloseHint"}}</span>
        </div>

        <div class="form-group">
            <label>{{localize "DH_QUICKACTIONS.FALLING.settings.close"}}</label>
            <input type="text" name="close" value="{{formulas.close}}" placeholder="{{localize "DH_QUICKACTIONS.FALLING.settings.placeholder" example="1d20+5"}}" maxlength="20">
            <span class="hint">{{localize "DH_QUICKACTIONS.FALLING.settings.closeHint"}}</span>
        </div>

        <div class="form-group">
            <label>{{localize "DH_QUICKACTIONS.FALLING.settings.far"}}</label>
            <input type="text" name="far" value="{{formulas.far}}" placeholder="{{localize "DH_QUICKACTIONS.FALLING.settings.placeholder" example="1d100+15"}}" maxlength="20">
            <span class="hint">{{localize "DH_QUICKACTIONS.FALLING.settings.farHint"}}</span>
        </div>

        <div class="form-group">
            <label>{{localize "DH_QUICKACTIONS.FALLING.settings.collision"}}</label>
            <input type="text" name="collision" value="{{formulas.collision}}" placeholder="{{localize "DH_QUICKACTIONS.FALLING.settings.placeholder" example="1d20+5"}}" maxlength="20">
            <span class="hint">{{localize "DH_QUICKACTIONS.FALLING.settings.collisionHint"}}</span>
        </div>

        <button type="button" class="reset-btn">
            <i class="fas fa-undo"></i> {{localize "DH_QUICKACTIONS.COMMON.resetToDefaults"}}
        </button>
    </div>

    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="far fa-save"></i> {{localize "DH_QUICKACTIONS.COMMON.saveConfiguration"}}
        </button>
    </footer>

</div>
