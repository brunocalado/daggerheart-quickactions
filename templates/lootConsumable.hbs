<div class="loot-consumable-container">

    <!-- 1. Topo: Seleção de Tipo (Botões Grandes) -->
    <div class="type-selection">
        <button type="button"
            class="type-btn {{#if isLoot}}active{{/if}}"
            data-action="selectType"
            data-type="Loot"
            title="Search Loot Tables">
            <img src="icons/containers/chest/chest-oak-steel-brown.webp" alt="Loot Icon"/>
            <span>Loot</span>
        </button>

        <button type="button"
            class="type-btn {{#if isConsumable}}active{{/if}}"
            data-action="selectType"
            data-type="Consumable"
            title="Search Consumable Tables">
            <img src="icons/consumables/potions/bottle-corked-red.webp" alt="Consumable Icon"/>
            <span>Consumable</span>
        </button>

        <button type="button"
            class="type-btn {{#if isCoins}}active{{/if}}"
            data-action="selectType"
            data-type="Coins"
            title="Roll Coins by Tier">
            <img src="icons/commodities/currency/coin-engraved-skull-gold.webp" alt="Coins Icon"/>
            <span>Coins</span>
        </button>
    </div>

    <hr class="divider">

    {{#unless isCoins}}
    <!-- 2. Dice pool: tap + to stack another d12. More dice reach rarer entries further down the
         table, capped at 5d12 — the tables hold 60 rarity-ordered entries, so beyond that the
         total can only run past the last one and get clamped back. The hint says what the current
         pool actually buys, including how much wider the pick gets with both books enabled. -->
    <div class="dice-pool-row">
        <button type="button" class="dice-adjust" data-action="adjustDice" data-delta="-1"
            title="Remove a d12" {{#if atMinDice}}disabled{{/if}}>&minus;</button>
        <div class="dice-pool-display"><span class="dice-pool-count">{{diceCount}}</span>d12</div>
        <button type="button" class="dice-adjust" data-action="adjustDice" data-delta="1"
            title="Add a d12 (max {{maxDice}}d12)" {{#if atMaxDice}}disabled{{/if}}>+</button>
    </div>

    <div class="reach-hint">{{reachHint}}</div>
    {{/unless}}

    {{#if isCoins}}
    <!-- Coins: Tier Selection -->
    <div class="tier-row">
        <button type="button" class="tier-btn {{#if (eq coinsTier 1)}}active{{/if}}" data-action="selectTier" data-tier="1">Tier 1</button>
        <button type="button" class="tier-btn {{#if (eq coinsTier 2)}}active{{/if}}" data-action="selectTier" data-tier="2">Tier 2</button>
        <button type="button" class="tier-btn {{#if (eq coinsTier 3)}}active{{/if}}" data-action="selectTier" data-tier="3">Tier 3</button>
        <button type="button" class="tier-btn {{#if (eq coinsTier 4)}}active{{/if}}" data-action="selectTier" data-tier="4">Tier 4</button>
    </div>
    {{/if}}

    <!-- 3. Queue: stack several draws ("3d12 loot, then 2d12 loot") and resolve them all with a
         single ROLL, into a single chat card. -->
    <div class="queue-row">
        <button type="button" class="queue-add-btn" data-action="queueRoll" title="Stack this roll and set up another">
            <i class="fas fa-layer-group"></i> Add to Roll
        </button>
    </div>

    {{#if hasQueue}}
    <ul class="queue-list">
        {{#each queue}}
        <li class="queue-item">
            <span class="queue-label">{{this.label}}</span>
            <button type="button" class="queue-remove" data-action="unqueueRoll" data-index="{{this.index}}" title="Remove">&times;</button>
        </li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if hasParty}}
    <!-- 4. Where the results land — a radio pair, only offered when the linked character belongs
         to a party sheet this user owns. Either way the choice is recorded in the chat card. -->
    <div class="destination-row">
        <button type="button" class="destination-btn {{#unless toParty}}active{{/unless}}"
            data-action="selectDestination" data-destination="self"
            title="Keep the results on your own sheet">
            <i class="fas fa-user"></i>
            <span>To Myself</span>
        </button>
        <button type="button" class="destination-btn {{#if toParty}}active{{/if}}"
            data-action="selectDestination" data-destination="party"
            title="Send the results to {{partyName}}">
            <i class="fas fa-users"></i>
            <span>To Party</span>
        </button>
    </div>
    {{/if}}

    <!-- 5. Footer: Botão Roll Grande -->
    <div class="footer-row">
        <button type="button" class="main-roll-btn" data-action="roll">
            <i class="fas fa-dice"></i> ROLL{{#if hasQueue}} &times;{{queueSize}}{{/if}}
        </button>
    </div>

</div>
