<div class="loot-consumable-container">

    <!-- 1. Topo: Seleção de Tipo (Botões Grandes) -->
    <div class="type-selection">
        <button type="button"
            class="type-btn {{#if isLoot}}active{{/if}}"
            data-action="selectType"
            data-type="Loot"
            title="{{localize 'DH_QUICKACTIONS.LOOT.searchLoot'}}">
            <img src="icons/containers/chest/chest-oak-steel-brown.webp" alt="{{localize 'DH_QUICKACTIONS.LOOT.lootIcon'}}"/>
            <span>{{localize "DH_QUICKACTIONS.LOOT.type.loot"}}</span>
        </button>

        <button type="button"
            class="type-btn {{#if isConsumable}}active{{/if}}"
            data-action="selectType"
            data-type="Consumable"
            title="{{localize 'DH_QUICKACTIONS.LOOT.searchConsumable'}}">
            <img src="icons/consumables/potions/bottle-corked-red.webp" alt="{{localize 'DH_QUICKACTIONS.LOOT.consumableIcon'}}"/>
            <span>{{localize "DH_QUICKACTIONS.LOOT.type.consumable"}}</span>
        </button>

        <button type="button"
            class="type-btn {{#if isCoins}}active{{/if}}"
            data-action="selectType"
            data-type="Coins"
            title="{{localize 'DH_QUICKACTIONS.LOOT.rollCoins'}}">
            <img src="icons/commodities/currency/coin-engraved-skull-gold.webp" alt="{{localize 'DH_QUICKACTIONS.LOOT.coinsIcon'}}"/>
            <span>{{localize "DAGGERHEART.CONFIG.Gold.coins"}}</span>
        </button>
    </div>

    <hr class="divider">

    {{#unless isCoins}}
    <!-- 2. Dice pool: tap + to stack another d12. More dice reach rarer entries further down the
         table, capped at 5d12 — the tables hold 60 rarity-ordered entries, so beyond that the
         total can only run past the last one and get clamped back. The hint says what the current
         pool actually buys, including how much wider the pick gets with both books enabled. -->
    <div class="dice-pool-row">
        <div class="pool-group">
            <button type="button" class="dice-adjust" data-action="adjustDice" data-delta="-1"
                title="{{localize 'DH_QUICKACTIONS.LOOT.removeDie'}}" {{#if atMinDice}}disabled{{/if}}>&minus;</button>
            <div class="dice-pool-display"><span class="dice-pool-count">{{diceCount}}</span>d12</div>
            <button type="button" class="dice-adjust" data-action="adjustDice" data-delta="1"
                title="{{localize 'DH_QUICKACTIONS.LOOT.addDie' max=maxDice}}" {{#if atMaxDice}}disabled{{/if}}>+</button>
        </div>

        <!-- Optional modifier, for the calls the stepper cannot express: it only moves in steps
             of twelve, so "+5" to shift the band and "+1d6" for a spread between 1d12 and 2d12
             both need to be typed. Left blank the roll is exactly the pool beside it, as before.
             Sits on the same line because the two together are one formula. -->
        <div class="mod-group">
            <label for="dh-qa-mod-formula">{{localize "DH_QUICKACTIONS.LOOT.mod"}}</label>
            <input type="text" id="dh-qa-mod-formula" class="mod-formula" name="mod"
                value="{{mod}}" placeholder="+5, +1d6, -2 …" autocomplete="off">
        </div>
    </div>

    <div class="reach-hint">{{reachHint}}</div>
    {{/unless}}

    {{#if isCoins}}
    <!-- Coins: Tier Selection -->
    <div class="tier-row">
        <button type="button" class="tier-btn {{#if (eq coinsTier 1)}}active{{/if}}" data-action="selectTier" data-tier="1">{{localize "DH_QUICKACTIONS.LOOT.settings.tier" number=1}}</button>
        <button type="button" class="tier-btn {{#if (eq coinsTier 2)}}active{{/if}}" data-action="selectTier" data-tier="2">{{localize "DH_QUICKACTIONS.LOOT.settings.tier" number=2}}</button>
        <button type="button" class="tier-btn {{#if (eq coinsTier 3)}}active{{/if}}" data-action="selectTier" data-tier="3">{{localize "DH_QUICKACTIONS.LOOT.settings.tier" number=3}}</button>
        <button type="button" class="tier-btn {{#if (eq coinsTier 4)}}active{{/if}}" data-action="selectTier" data-tier="4">{{localize "DH_QUICKACTIONS.LOOT.settings.tier" number=4}}</button>
    </div>
    {{/if}}

    <!-- 3. Queue: stack several draws ("3d12 loot, then 2d12 loot") and resolve them all with a
         single ROLL, into a single chat card. -->
    <div class="queue-row">
        <button type="button" class="queue-add-btn" data-action="queueRoll" title="{{localize 'DH_QUICKACTIONS.LOOT.stackRoll'}}">
            <i class="fas fa-layer-group"></i> {{localize "DH_QUICKACTIONS.ROLLER.addToRoll"}}
        </button>
    </div>

    {{#if hasQueue}}
    <ul class="queue-list">
        {{#each queue}}
        <li class="queue-item">
            <span class="queue-label">{{this.label}}</span>
            <button type="button" class="queue-remove" data-action="unqueueRoll" data-index="{{this.index}}" title="{{localize 'DH_QUICKACTIONS.COMMON.remove'}}">&times;</button>
        </li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if hasParty}}
    <!-- 4. Where the results land — a radio pair, only offered when the linked character belongs
         to a party sheet this user owns. Either way the choice is recorded in the chat card. -->
    <div class="destination-row">
        <button type="button" class="destination-btn {{#unless toParty}}active{{/unless}}"
            data-action="selectDestination" data-destination="self"
            title="{{localize 'DH_QUICKACTIONS.ROLLER.keepTooltip'}}">
            <i class="fas fa-user"></i>
            <span>{{localize "DH_QUICKACTIONS.ROLLER.toMyself"}}</span>
        </button>
        <button type="button" class="destination-btn {{#if toParty}}active{{/if}}"
            data-action="selectDestination" data-destination="party"
            title="{{localize 'DH_QUICKACTIONS.ROLLER.partyTooltip' name=partyName}}">
            <i class="fas fa-users"></i>
            <span>{{localize "DH_QUICKACTIONS.ROLLER.toParty"}}</span>
        </button>
    </div>
    {{/if}}

    <!-- 5. Footer: Botão Roll Grande -->
    <div class="footer-row">
        <button type="button" class="main-roll-btn" data-action="roll">
            <i class="fas fa-dice"></i> {{localize "DH_QUICKACTIONS.ROLLER.roll"}}{{#if hasQueue}} &times;{{queueSize}}{{/if}}
        </button>
    </div>

</div>
