<div class="dh-rr-container">
    <label class="dh-rr-label">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.shape"}}</label>
    <div class="dh-trait-grid dh-trait-grid--5">
        <button type="button" class="dh-trait-btn {{#if (eq type 'circle')}}active{{/if}}" data-action="selectType" data-value="circle">
            <i class="fas fa-circle" style="margin-right:4px"></i>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.circle"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'cone')}}active{{/if}}" data-action="selectType" data-value="cone">
            <i class="fas fa-wifi" style="transform: rotate(-45deg); margin-right:4px"></i>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.cone"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'front')}}active{{/if}}" data-action="selectType" data-value="front">
            <i class="fas fa-wifi" style="margin-right:4px"></i>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.front"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'ray')}}active{{/if}}" data-action="selectType" data-value="ray">
            <i class="fas fa-bolt" style="margin-right:4px"></i>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.ray"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'rect')}}active{{/if}}" data-action="selectType" data-value="rect">
            <i class="fas fa-square" style="margin-right:4px"></i>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.rect"}}
        </button>
    </div>

    <label class="dh-rr-label" style="margin-top: 12px;">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.distance"}}</label>
    <div class="dh-trait-grid">
        <button type="button" class="dh-trait-btn {{#if (eq range 'm')}}active{{/if}}" data-action="selectRange" data-value="m">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.melee"}}</button>
        <button type="button" class="dh-trait-btn {{#if (eq range 'vc')}}active{{/if}}" data-action="selectRange" data-value="vc">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.veryClose"}}</button>
        <button type="button" class="dh-trait-btn {{#if (eq range 'c')}}active{{/if}}" data-action="selectRange" data-value="c">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.close"}}</button>
        <button type="button" class="dh-trait-btn {{#if (eq range 'f')}}active{{/if}}" data-action="selectRange" data-value="f">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.far"}}</button>
    </div>

    <div class="dh-copy-row">
        <input type="text" id="dh-template-code" class="dh-copy-input" readonly value="{{codeString}}">
        <button type="button" data-action="copyCode" class="dh-trait-btn" style="width: auto; padding: 0 10px; height: 32px;">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.copy"}}</button>
        <button type="button" data-action="chatCode" class="dh-sq-action-btn" title="{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.sendToChat"}}"><i class="fas fa-comment"></i></button>
    </div>

    {{#if hasTokenMagic}}
    <label class="dh-rr-label" style="margin-top: 12px;">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.magicEffect"}}</label>
    <select id="dh-effect-select" data-action="changeEffect" class="dh-select">
        <option value="none" {{#if (eq effect 'none')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.none"}}</option>
        <option value="glow" {{#if (eq effect 'glow')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.glow"}}</option>
        <option value="rays" {{#if (eq effect 'rays')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.rays"}}</option>
        <option value="bulge" {{#if (eq effect 'bulge')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.bulge"}}</option>
        <option value="classic_rays" {{#if (eq effect 'classic_rays')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.classicRays"}}</option>
        <option value="classic_rays_2" {{#if (eq effect 'classic_rays_2')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.classicRays2"}}</option>
        <option value="fairy" {{#if (eq effect 'fairy')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.fairy"}}</option>
        <option value="fire" {{#if (eq effect 'fire')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.fire"}}</option>
        <option value="flames" {{#if (eq effect 'flames')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.flames"}}</option>
        <option value="protoplasm" {{#if (eq effect 'protoplasm')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.protoplasm"}}</option>
        <option value="water" {{#if (eq effect 'water')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.water"}}</option>
        <option value="zone_blizzard" {{#if (eq effect 'zone_blizzard')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.zoneBlizzard"}}</option>
        <option value="zone_electricity" {{#if (eq effect 'zone_electricity')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.zoneElectricity"}}</option>
        <option value="zone_fire" {{#if (eq effect 'zone_fire')}}selected{{/if}}>{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.effects.zoneFire"}}</option>
    </select>
    {{/if}}

    <div class="dh-checkbox-row">
        <input type="checkbox" id="dh-hidden-checkbox" data-action="toggleHidden" {{#if hidden}}checked{{/if}}>
        <label for="dh-hidden-checkbox" class="dh-rr-label" style="margin-bottom: 0; cursor: pointer;">{{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.hideTemplate"}}</label>
    </div>

    <hr class="dh-hr">

    <div class="dh-actions">
        <button type="button" class="dh-btn-submit" data-action="createTemplate">
            <i class="fas fa-crosshairs"></i> {{localize "DH_QUICKACTIONS.TEMPLATE_CREATOR.place"}}
        </button>
    </div>
</div>
