<div class="dh-rr-container">
    <label class="dh-rr-label">{{localize "DHQA.TemplateCreator.Shape"}}</label>
    <div class="dh-trait-grid dh-trait-grid--5">
        <button type="button" class="dh-trait-btn {{#if (eq type 'circle')}}active{{/if}}" data-action="selectType" data-value="circle">
            <i class="fas fa-circle" style="margin-right:4px"></i>{{localize "DHQA.TemplateCreator.Circle"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'cone')}}active{{/if}}" data-action="selectType" data-value="cone">
            <i class="fas fa-wifi" style="transform: rotate(-45deg); margin-right:4px"></i>{{localize "DHQA.TemplateCreator.Cone"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'front')}}active{{/if}}" data-action="selectType" data-value="front">
            <i class="fas fa-wifi" style="margin-right:4px"></i>{{localize "DHQA.TemplateCreator.Front"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'ray')}}active{{/if}}" data-action="selectType" data-value="ray">
            <i class="fas fa-bolt" style="margin-right:4px"></i>{{localize "DHQA.TemplateCreator.Ray"}}
        </button>
        <button type="button" class="dh-trait-btn {{#if (eq type 'rect')}}active{{/if}}" data-action="selectType" data-value="rect">
            <i class="fas fa-square" style="margin-right:4px"></i>{{localize "DHQA.TemplateCreator.Rect"}}
        </button>
    </div>

    <label class="dh-rr-label" style="margin-top: 12px;">{{localize "DHQA.TemplateCreator.Distance"}}</label>
    <div class="dh-trait-grid">
        <button type="button" class="dh-trait-btn {{#if (eq range 'm')}}active{{/if}}" data-action="selectRange" data-value="m">{{localize "DHQA.TemplateCreator.Melee"}}</button>
        <button type="button" class="dh-trait-btn {{#if (eq range 'vc')}}active{{/if}}" data-action="selectRange" data-value="vc">{{localize "DHQA.TemplateCreator.VClose"}}</button>
        <button type="button" class="dh-trait-btn {{#if (eq range 'c')}}active{{/if}}" data-action="selectRange" data-value="c">{{localize "DHQA.TemplateCreator.Close"}}</button>
        <button type="button" class="dh-trait-btn {{#if (eq range 'f')}}active{{/if}}" data-action="selectRange" data-value="f">{{localize "DHQA.TemplateCreator.Far"}}</button>
    </div>

    <div class="dh-copy-row">
        <input type="text" id="dh-template-code" class="dh-copy-input" readonly value="{{codeString}}">
        <button type="button" data-action="copyCode" class="dh-trait-btn" style="width: auto; padding: 0 10px; height: 32px;">{{localize "DHQA.TemplateCreator.Copy"}}</button>
        <button type="button" data-action="chatCode" class="dh-sq-action-btn" title="{{localize 'DHQA.TemplateCreator.SendToChat'}}"><i class="fas fa-comment"></i></button>
    </div>

    {{#if hasTokenMagic}}
    <label class="dh-rr-label" style="margin-top: 12px;">{{localize "DHQA.TemplateCreator.MagicEffect"}}</label>
    <select id="dh-effect-select" data-action="changeEffect" class="dh-select">
        <option value="none" {{#if (eq effect 'none')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.None"}}</option>
        <option value="glow" {{#if (eq effect 'glow')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.GlowingOutline"}}</option>
        <option value="rays" {{#if (eq effect 'rays')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.AnnihilatingRays"}}</option>
        <option value="bulge" {{#if (eq effect 'bulge')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.BulgingOut"}}</option>
        <option value="classic_rays" {{#if (eq effect 'classic_rays')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.ClassicRays"}}</option>
        <option value="classic_rays_2" {{#if (eq effect 'classic_rays_2')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.ClassicRays2"}}</option>
        <option value="fairy" {{#if (eq effect 'fairy')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.FairyFireflies"}}</option>
        <option value="fire" {{#if (eq effect 'fire')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.FireRays"}}</option>
        <option value="flames" {{#if (eq effect 'flames')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.Flames"}}</option>
        <option value="protoplasm" {{#if (eq effect 'protoplasm')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.Protoplasm"}}</option>
        <option value="water" {{#if (eq effect 'water')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.WaterySurface"}}</option>
        <option value="zone_blizzard" {{#if (eq effect 'zone_blizzard')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.ZoneBlizzard"}}</option>
        <option value="zone_electricity" {{#if (eq effect 'zone_electricity')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.ZoneElectricity"}}</option>
        <option value="zone_fire" {{#if (eq effect 'zone_fire')}}selected{{/if}}>{{localize "DHQA.TemplateCreator.ZoneFire"}}</option>
    </select>
    {{/if}}

    <div class="dh-checkbox-row">
        <input type="checkbox" id="dh-hidden-checkbox" data-action="toggleHidden" {{#if hidden}}checked{{/if}}>
        <label for="dh-hidden-checkbox" class="dh-rr-label" style="margin-bottom: 0; cursor: pointer;">{{localize "DHQA.TemplateCreator.HideTemplate"}}</label>
    </div>

    <hr class="dh-hr">

    <div class="dh-actions">
        <button type="button" class="dh-btn-submit" data-action="createTemplate">
            <i class="fas fa-crosshairs"></i> {{localize "DHQA.TemplateCreator.PlaceTemplate"}}
        </button>
    </div>
</div>
