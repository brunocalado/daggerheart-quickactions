<div class="dui-cfg-container">
    {{!-- Tab Bar --}}
    <nav class="dui-cfg-tab-bar">
        <button type="button" class="dui-cfg-tab active" data-tab="core">{{localize "DHQA.ConfigureMoves.Core"}}</button>
        <button type="button" class="dui-cfg-tab" data-tab="craft">{{localize "DHQA.ConfigureMoves.Craft"}}</button>
        <button type="button" class="dui-cfg-tab" data-tab="custom">{{localize "DHQA.ConfigureMoves.Custom"}}</button>
        <button type="button" class="dui-cfg-tab" data-tab="itemmoves">{{localize "DHQA.ConfigureMoves.ItemMoves"}}</button>
        <button type="button" class="dui-cfg-tab" data-tab="users">{{localize "DHQA.ConfigureMoves.Users"}}</button>
    </nav>

    {{!-- Core Features Panel --}}
    <div class="dui-cfg-panel active" data-panel="core">
        <div class="dui-core-info">
            <i class="fas fa-info-circle"></i>
            <span>{{localize "DHQA.ConfigureMoves.TheseAreTheDefaultCore"}}</span>
        </div>
        <div class="dui-core-list" id="dui-core-list">
            {{#each coreFeatures}}
            <div class="dui-core-row" data-index="{{@index}}" data-key="{{this.key}}">
                <div class="dui-core-label-group">
                    <span class="dui-core-label">{{this.label}}</span>
                    {{#if this.description}}
                    <span class="dui-core-help" data-tip="{{this.description}}">
                        <i class="fas fa-question-circle"></i>
                    </span>
                    {{/if}}
                </div>
                <div class="dui-core-drop {{#if this.itemName}}filled{{else}}empty{{/if}}" data-index="{{@index}}">
                    <i class="fas fa-star"></i>
                    <span class="dui-core-item-name">{{#if this.itemName}}{{this.itemName}}{{else}}{{localize "DHQA.ConfigureMoves.DragItemHere"}}{{/if}}</span>
                </div>
                {{#if this.itemName}}
                <button type="button" class="dui-craft-remove" data-action="removeCoreItem" data-index="{{@index}}" title="{{localize 'DHQA.ConfigureMoves.RemoveItem'}}">
                    <i class="fas fa-times"></i>
                </button>
                {{/if}}
                <input type="hidden" name="coreItem_{{@index}}" value="{{this.itemUuid}}">
                <input type="hidden" name="coreKey_{{@index}}" value="{{this.key}}">
                <input type="hidden" name="coreLabel_{{@index}}" value="{{this.label}}">
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- Craft Panel --}}
    <div class="dui-cfg-panel" data-panel="craft">
        <div class="dui-core-info">
            <i class="fas fa-info-circle"></i>
            <span>{{localize "DHQA.ConfigureMoves.IfAnActorOwnsThe"}}</span>
        </div>
        <button type="button" class="dui-craft-add-btn" data-action="addCraftRow">
            <i class="fas fa-plus"></i>
        </button>
        <div class="dui-craft-list" id="dui-craft-list">
            {{#each craftEntries}}
            <div class="dui-craft-row" data-index="{{@index}}">
                <div class="dui-craft-drop {{#if this.recipeName}}filled{{else}}empty{{/if}}" data-slot="recipe" data-index="{{@index}}">
                    <i class="fas fa-scroll"></i>
                    <span class="dui-craft-name">{{#if this.recipeName}}{{this.recipeName}}{{else}}{{localize "DHQA.ConfigureMoves.DragRecipeHere"}}{{/if}}</span>
                </div>
                <i class="fas fa-arrow-right dui-craft-arrow"></i>
                <div class="dui-craft-drop {{#if this.craftName}}filled{{else}}empty{{/if}}" data-slot="craft" data-index="{{@index}}">
                    <i class="fas fa-flask"></i>
                    <span class="dui-craft-name">{{#if this.craftName}}{{this.craftName}}{{else}}{{localize "DHQA.ConfigureMoves.DragCraftedItemHere"}}{{/if}}</span>
                </div>
                <button type="button" class="dui-craft-remove" data-action="removeCraftRow" data-index="{{@index}}" title="{{localize 'DHQA.ConfigureMoves.Remove'}}">
                    <i class="fas fa-times"></i>
                </button>
                <input type="hidden" name="craftRecipe_{{@index}}" value="{{this.recipeUuid}}">
                <input type="hidden" name="craftCraft_{{@index}}" value="{{this.craftUuid}}">
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- Custom Panel --}}
    <div class="dui-cfg-panel" data-panel="custom">
        <div class="dui-core-info">
            <i class="fas fa-info-circle"></i>
            <span>{{localize "DHQA.ConfigureMoves.AddCustomMoveNamesThat"}}</span>
        </div>
        <button type="button" class="dui-craft-add-btn" data-action="addCustomRow">
            <i class="fas fa-plus"></i>
        </button>
        <div class="dui-custom-list" id="dui-custom-list">
            {{#each customMoves}}
            <div class="dui-custom-row" data-index="{{@index}}">
                <input type="text" class="dui-custom-input" name="customMove_{{@index}}" value="{{this.label}}" maxlength="27" placeholder="{{localize 'DHQA.ConfigureMoves.MoveName'}}">
                <select class="dui-rest-type-select">
                    <option value="any" {{#if (eq this.restType "any")}}selected{{/if}}>{{localize "DHQA.ConfigureMoves.Any"}}</option>
                    <option value="short" {{#if (eq this.restType "short")}}selected{{/if}}>{{localize "DHQA.ConfigureMoves.Short"}}</option>
                    <option value="long" {{#if (eq this.restType "long")}}selected{{/if}}>{{localize "DHQA.ConfigureMoves.Long"}}</option>
                </select>
                <button type="button" class="dui-craft-remove" data-action="removeCustomRow" data-index="{{@index}}" title="{{localize 'DHQA.ConfigureMoves.Remove'}}">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- Item Moves Panel --}}
    <div class="dui-cfg-panel" data-panel="itemmoves">
        <div class="dui-core-info">
            <i class="fas fa-info-circle"></i>
            <span>{{localize "DHQA.ConfigureMoves.DragItemsHereToCreate"}}</span>
        </div>
        <button type="button" class="dui-craft-add-btn" data-action="addItemMoveRow">
            <i class="fas fa-plus"></i>
        </button>
        <div class="dui-itemmove-list" id="dui-itemmove-list">
            {{#each itemMoveEntries}}
            <div class="dui-itemmove-row" data-index="{{@index}}">
                <div class="dui-itemmove-drop {{#if this.itemName}}filled{{else}}empty{{/if}}" data-index="{{@index}}">
                    <i class="fas fa-box-open"></i>
                    <span class="dui-itemmove-name">{{#if this.itemName}}{{this.itemName}}{{else}}{{localize "DHQA.ConfigureMoves.DragItemHere"}}{{/if}}</span>
                </div>
                <select class="dui-rest-type-select">
                    <option value="any" {{#if (eq this.restType "any")}}selected{{/if}}>{{localize "DHQA.ConfigureMoves.Any"}}</option>
                    <option value="short" {{#if (eq this.restType "short")}}selected{{/if}}>{{localize "DHQA.ConfigureMoves.Short"}}</option>
                    <option value="long" {{#if (eq this.restType "long")}}selected{{/if}}>{{localize "DHQA.ConfigureMoves.Long"}}</option>
                </select>
                <button type="button" class="dui-craft-remove" data-action="removeItemMoveRow" data-index="{{@index}}" title="{{localize 'DHQA.ConfigureMoves.Remove'}}">
                    <i class="fas fa-times"></i>
                </button>
                <input type="hidden" name="itemMove_{{@index}}" value="{{this.itemUuid}}">
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- Users Panel --}}
    <div class="dui-cfg-panel" data-panel="users">
        <div class="dui-core-info">
            <i class="fas fa-info-circle"></i>
            <span>{{localize "DHQA.ConfigureMoves.SwitchOffAnyUserWho"}}</span>
        </div>
        <div class="dui-user-list" id="dui-user-list">
            {{#each users}}
            <div class="dui-user-row {{#unless this.active}}dui-user-row--offline{{/unless}}" data-user-id="{{this.id}}">
                <button type="button" class="dui-user-toggle {{#if this.enabled}}checked{{/if}}" data-action="toggleDowntimeUser" title="{{localize 'DHQA.ConfigureMoves.TakePartInDowntime'}}">
                    <span class="dui-user-toggle-slider"></span>
                </button>
                <span class="dui-user-row-name">{{this.name}}</span>
                <span class="dui-user-row-char">{{#if this.characterName}}{{this.characterName}}{{else}}{{localize "DHQA.ConfigureMoves.NoCharacter"}}{{/if}}</span>
            </div>
            {{else}}
            <div class="dui-user-empty">{{localize "DHQA.ConfigureMoves.NoPlayersFound"}}</div>
            {{/each}}
        </div>
    </div>

    {{!-- Footer --}}
    <div class="dui-cfg-footer">
        <button type="button" class="dui-cfg-save-btn" data-action="saveMovesConfig">
            <i class="fas fa-save"></i> {{localize "DHQA.ConfigureMoves.Save"}}
        </button>
    </div>

</div>
