<div class="custom-tables-container">

    {{#if hasTables}}
    <!-- 1. Which table to roll. A select rather than the SRD roller's image buttons: the list is
         whatever the GM configured, so it has no fixed length to lay out. -->
    <div class="table-row">
        <label for="dh-qa-custom-table">{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.table"}}</label>
        <select id="dh-qa-custom-table" class="table-select" name="table">
            {{#each tables}}
            <option value="{{this.uuid}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </div>

    <hr class="divider">

    <!-- 2. How many times to draw from that table. Each draw is a separate roll of the table's
         own formula, so there is no ceiling to show here — unlike the SRD roller, where the pool
         size is bounded by the 60 rarity positions its tables hold. -->
    <div class="draws-row">
        <button type="button" class="draw-adjust" data-action="adjustDraws" data-delta="-1"
            title="{{localize 'DH_QUICKACTIONS.CUSTOM_TABLES.drawFewer'}}" {{#if atMinDraws}}disabled{{/if}}>&minus;</button>
        <div class="draws-display">{{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.drawCount" count=draws}}}</div>
        <button type="button" class="draw-adjust" data-action="adjustDraws" data-delta="1"
            title="{{localize 'DH_QUICKACTIONS.CUSTOM_TABLES.drawMore'}}">+</button>
    </div>

    <!-- 3. Queue: stack draws from several tables and resolve them all with a single ROLL, into a
         single chat card. -->
    <div class="queue-row">
        <button type="button" class="queue-add-btn" data-action="queueRoll" title="{{localize 'DH_QUICKACTIONS.CUSTOM_TABLES.stackDraw'}}">
            <i class="fas fa-layer-group"></i> {{localize "DH_QUICKACTIONS.ROLLER.addToRoll"}}
        </button>
    </div>

    {{#if hasQueue}}
    <ul class="queue-list">
        {{#each queue}}
        <li class="queue-item">
            <span class="queue-label">{{this.label}}</span>
            <button type="button" class="queue-remove" data-action="unqueueRoll" data-index="{{this.index}}" title="{{localize 'DH_QUICKACTIONS.COMMON.remove'}}">&times;</button>
        </li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if hasParty}}
    <!-- 4. Where the results land — a radio pair, only offered when the linked character belongs
         to a party sheet this user owns. Either way the choice is recorded in the chat card. -->
    <div class="destination-row">
        <button type="button" class="destination-btn {{#unless toParty}}active{{/unless}}"
            data-action="selectDestination" data-destination="self"
            title="{{localize 'DH_QUICKACTIONS.ROLLER.keepTooltip'}}">
            <i class="fas fa-user"></i>
            <span>{{localize "DH_QUICKACTIONS.ROLLER.toMyself"}}</span>
        </button>
        <button type="button" class="destination-btn {{#if toParty}}active{{/if}}"
            data-action="selectDestination" data-destination="party"
            title="{{localize 'DH_QUICKACTIONS.ROLLER.partyTooltip' name=partyName}}">
            <i class="fas fa-users"></i>
            <span>{{localize "DH_QUICKACTIONS.ROLLER.toParty"}}</span>
        </button>
    </div>
    {{/if}}

    <!-- 5. Footer: big ROLL button -->
    <div class="footer-row">
        <button type="button" class="main-roll-btn" data-action="roll">
            <i class="fas fa-dice"></i> {{localize "DH_QUICKACTIONS.ROLLER.roll"}}{{#if hasQueue}} &times;{{queueSize}}{{/if}}
        </button>
    </div>

    {{else}}
    <div class="empty-state">
        <i class="fas fa-dice-d20"></i>
        <p>{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.empty"}}</p>
        <p class="empty-hint">{{{localize "DH_QUICKACTIONS.CUSTOM_TABLES.emptyHint"}}}</p>
    </div>
    {{/if}}

</div>
