<div class="dui-cfg-container">

    {{!-- General Panel --}}
    <div class="dui-cfg-panel active" data-panel="general">
        <div class="dui-cfg-field">
            <label>{{localize "DH_QUICKACTIONS.DOWNTIME.configureActor.maxActions"}}</label>
            <input type="number" name="maxChoices" value="{{maxChoices}}" min="1" max="6">
        </div>
        <hr class="dui-cfg-divider">
        <div class="dui-cfg-section-title">{{localize "DH_QUICKACTIONS.DOWNTIME.configureActor.modifiersHeading"}}</div>
        <div class="dui-cfg-field">
            <label>{{localize "DH_QUICKACTIONS.DOWNTIME.configureActor.hpModifier"}}</label>
            <input type="number" name="hpModifier" value="{{hpModifier}}" min="0" max="10">
        </div>
        <div class="dui-cfg-field">
            <label>{{localize "DH_QUICKACTIONS.DOWNTIME.configureActor.stressModifier"}}</label>
            <input type="number" name="stressModifier" value="{{stressModifier}}" min="0" max="10">
        </div>
        <div class="dui-cfg-field">
            <label>{{localize "DH_QUICKACTIONS.DOWNTIME.configureActor.hopeModifier"}}</label>
            <input type="number" name="hopeModifier" value="{{hopeModifier}}" min="0" max="10">
        </div>
        <div class="dui-cfg-field">
            <label>{{localize "DH_QUICKACTIONS.DOWNTIME.configureActor.armorModifier"}}</label>
            <input type="number" name="armorSlotModifier" value="{{armorSlotModifier}}" min="0" max="10">
        </div>
    </div>

    {{!-- Footer --}}
    <div class="dui-cfg-footer">
        <button type="button" class="dui-cfg-save-btn" data-action="saveConfig">
            <i class="fas fa-save"></i> {{localize "DH_QUICKACTIONS.DOWNTIME.save"}}
        </button>
    </div>

</div>
