<div class="scan-settings-wrapper">

    <!-- NAVIGATION TABS -->
    <nav class="tracker-nav tabs">
        <a class="item active" data-tab="general"><i class="fas fa-cog"></i> {{localize "DHQA.ScanSettingsMenu.General"}}</a>
        <a class="item" data-tab="hp"><i class="fas fa-heart"></i> {{localize "DHQA.ScanSettingsMenu.PhysicalState"}}</a>
        <a class="item" data-tab="stress"><i class="fas fa-brain"></i> {{localize "DHQA.ScanSettingsMenu.MentalState"}}</a>
    </nav>

    <!-- TAB CONTENT CONTAINER -->
    <section class="tab-content">

        <!-- =======================
             TAB: GENERAL SETTINGS
             ======================= -->
        <div class="tab active" data-tab="general">
            <div class="config-card">
                <h3><i class="fas fa-cog"></i> {{localize "DHQA.ScanSettingsMenu.GeneralSettings"}}</h3>

                <div class="form-group toggle-group">
                    <label for="enableScanToggle">{{localize "DHQA.ScanSettingsMenu.EnableTokenScan"}}</label>
                    <input type="checkbox" id="enableScanToggle" name="enableScan" value="true" {{#if enableScan}}checked{{/if}}>
                    <span class="hint">{{localize "DHQA.ScanSettingsMenu.AllowsNonGmUsersTo"}}</span>
                </div>
            </div>
        </div>

        <!-- =======================
             TAB: HP LABELS
             ======================= -->
        <div class="tab" data-tab="hp">
            <div class="config-card">
                <h3><i class="fas fa-heart"></i> {{localize "DHQA.ScanSettingsMenu.PhysicalStateConfiguration"}}</h3>

                <div class="form-group">
                    <label>{{localize "DHQA.ScanSettingsMenu.ChatCardTitle"}}</label>
                    <input type="text" name="hpTitle" value="{{hpTitle}}" maxlength="30" placeholder="{{localize 'DHQA.ScanSettingsMenu.PhysicalState'}}">
                    <span class="hint">{{localize "DHQA.ScanSettingsMenu.TheHeadingDisplayedOnThe"}}</span>
                </div>

                <div class="label-list" data-label-type="hp">
                    {{#each hpLabels}}
                    <div class="label-row">
                        <span class="label-threshold">{{this.min}}%+</span>
                        <input type="text" class="label-text" name="hpLabel-{{this.min}}" value="{{this.label}}" maxlength="140" placeholder="{{localize 'DHQA.ScanSettingsMenu.DescriptiveLabel'}}">
                    </div>
                    {{/each}}
                </div>

                <button type="button" class="reset-btn" data-reset="hp">
                    <i class="fas fa-undo"></i> {{localize "DHQA.ScanSettingsMenu.ResetToDefaults"}}
                </button>
            </div>
        </div>

        <!-- =======================
             TAB: STRESS LABELS
             ======================= -->
        <div class="tab" data-tab="stress">
            <div class="config-card">
                <h3><i class="fas fa-brain"></i> {{localize "DHQA.ScanSettingsMenu.MentalStateConfiguration"}}</h3>

                <div class="form-group">
                    <label>{{localize "DHQA.ScanSettingsMenu.ChatCardTitle"}}</label>
                    <input type="text" name="stressTitle" value="{{stressTitle}}" maxlength="30" placeholder="{{localize 'DHQA.ScanSettingsMenu.MentalState'}}">
                    <span class="hint">{{localize "DHQA.ScanSettingsMenu.TheHeadingDisplayedOnThe2"}}</span>
                </div>

                <div class="label-list" data-label-type="stress">
                    {{#each stressLabels}}
                    <div class="label-row">
                        <span class="label-threshold">{{this.min}}%+</span>
                        <input type="text" class="label-text" name="stressLabel-{{this.min}}" value="{{this.label}}" maxlength="140" placeholder="{{localize 'DHQA.ScanSettingsMenu.DescriptiveLabel'}}">
                    </div>
                    {{/each}}
                </div>

                <button type="button" class="reset-btn" data-reset="stress">
                    <i class="fas fa-undo"></i> {{localize "DHQA.ScanSettingsMenu.ResetToDefaults"}}
                </button>
            </div>
        </div>

    </section>

    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="far fa-save"></i> {{localize "DHQA.ScanSettingsMenu.SaveConfiguration"}}
        </button>
    </footer>
</div>
