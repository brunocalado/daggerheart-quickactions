<div class="dui-container">
    {{#if isGM}}
    <div class="dui-toolbar">
        <div class="dui-toggle-type">
            <button type="button" class="dui-rest-btn {{#if isShort}}active{{/if}}" data-action="setRestType" data-rest-type="short">
                <i class="fas fa-campground"></i> {{localize "DHQA.DowntimeUi.Short"}}
            </button>
            <button type="button" class="dui-rest-btn {{#if isLong}}active{{/if}}" data-action="setRestType" data-rest-type="long">
                <i class="fas fa-bed"></i> {{localize "DHQA.DowntimeUi.Long"}}
            </button>
        </div>
        <div class="dui-short-rest-counter" title="{{localize 'DHQA.DowntimeUi.ConsecutiveShortRestsTakenResets'}}">
            {{#each shortRestPips}}
            <button type="button" class="dui-rest-pip{{#if this.filled}} dui-rest-pip--filled{{/if}}{{#if this.warn}} dui-rest-pip--warn{{/if}}" data-action="setShortRestCount" data-count="{{this.value}}" title="{{localize 'DHQA.DowntimeUi.SetCounter' value=this.value}}"></button>
            {{/each}}
        </div>
        <button type="button" class="dui-moves-btn" data-action="openMovesConfig">
            <i class="fas fa-cog"></i> {{localize "DHQA.DowntimeUi.Config"}}
        </button>
        <button type="button" class="dui-start-btn" data-action="startDowntime">
            <i class="fas fa-play" style="font-size: 10px;"></i> {{localize "DHQA.DowntimeUi.StartDowntime"}}
        </button>
        <button type="button" class="dui-resend-btn" data-action="resendDowntime" title="{{localize 'DHQA.DowntimeUi.ReOpenDowntimeUiFor'}}">
            <i class="fas fa-share-square"></i>
        </button>
    </div>
    {{/if}}

    <!-- Header visible only to players -->
    {{#unless isGM}}
    <div class="dui-rest-header">{{restLabel}}</div>
    {{/unless}}

    <div class="dui-player-list">
        {{#each rows}}
        <!-- Added 'player-view' class if not GM to adjust Grid in CSS -->
        <div class="dui-row {{#unless this.included}}dui-row--excluded{{/unless}} {{#unless this.isGM}}player-view{{/unless}} {{#if this.hasPrepare}}dui-row--preparing{{/if}}" data-actor-id="{{this.actorId}}">

            <!-- This column exists only for the GM -->
            {{#if this.isGM}}
            <div class="dui-controls-col">
                <button type="button" class="dui-toggle-switch {{#if this.included}}checked{{/if}}" data-action="toggleIncluded" data-actor-id="{{this.actorId}}" title="{{localize 'DHQA.DowntimeUi.IncludeInDowntime'}}">
                    <span class="dui-toggle-slider"></span>
                </button>
                <button type="button" class="dui-config-btn" data-action="configMaxChoices" data-actor-id="{{this.actorId}}" title="{{localize 'DHQA.DowntimeUi.Configure'}}">
                    <i class="fas fa-cog"></i>
                </button>
            </div>
            {{/if}}

            <!-- Identity Column -->
            <div class="dui-identity">
                <img class="dui-avatar" src="{{this.avatar}}" alt="{{this.actorName}}" />
                <div class="dui-info-text">
                    <span class="dui-actor-name">{{this.actorName}}</span>
                    <span class="dui-user-name">({{this.userName}})</span>
                </div>
            </div>

            <div class="dui-badges-container">
                {{#if this.domainCardStatus}}
                <div class="dui-domain-card-badge {{this.domainCardStatus.type}}">
                    <span class="dui-domain-card-label">{{this.domainCardStatus.count}}</span>
                    <i class="fas fa-clone"></i>
                    <span class="dui-domain-card-tooltip">{{this.domainCardStatus.message}}</span>
                </div>
                {{/if}}

                {{#if this.refreshFeatures.length}}
                <div class="dui-refresh-badge">
                    <span class="dui-refresh-label">{{localize "DHQA.DowntimeUi.RefreshingResources"}}</span>
                    <i class="fas fa-sync-alt"></i>
                    <span class="dui-refresh-tooltip">
                        {{#each this.refreshFeatures}}
                        <span class="dui-refresh-feature">{{this}}</span>
                        {{/each}}
                    </span>
                </div>
                {{/if}}
            </div>

            <!-- Resource stats row -->
            <div class="dui-stats-row">
                <div class="dui-stat-item">
                    <span class="dui-stat-label"><i class="fas fa-heart"></i> {{localize "DHQA.DowntimeUi.Hp"}}</span>
                    <div class="dui-stat-bar-wrap">
                        <div class="dui-stat-bar dui-stat-bar--hp" style="--progress: {{this.hpPct}}%"></div>
                    </div>
                    <span class="dui-stat-value">{{this.hp.value}}/{{this.hp.max}}</span>
                </div>
                <div class="dui-stat-item">
                    <span class="dui-stat-label"><i class="fas fa-bolt"></i> {{localize "DHQA.DowntimeUi.Stress"}}</span>
                    <div class="dui-stat-bar-wrap">
                        <div class="dui-stat-bar dui-stat-bar--stress" style="--progress: {{this.stressPct}}%"></div>
                    </div>
                    <span class="dui-stat-value">{{this.stress.value}}/{{this.stress.max}}</span>
                </div>
                <div class="dui-stat-item">
                    <span class="dui-stat-label"><i class="fas fa-shield-alt"></i> {{localize "DHQA.DowntimeUi.Armor"}}</span>
                    <div class="dui-stat-bar-wrap">
                        <div class="dui-stat-bar dui-stat-bar--armor" style="--progress: {{this.armorPct}}%"></div>
                    </div>
                    <span class="dui-stat-value">{{this.armor.value}}/{{this.armor.max}}</span>
                </div>
                <div class="dui-stat-item">
                    <span class="dui-stat-label"><i class="fas fa-sun"></i> {{localize "DHQA.DowntimeUi.Hope"}}</span>
                    <div class="dui-stat-bar-wrap">
                        <div class="dui-stat-bar dui-stat-bar--hope" style="--progress: {{this.hopePct}}%"></div>
                    </div>
                    <span class="dui-stat-value">{{this.hope.value}}/{{this.hope.max}}</span>
                </div>
            </div>

            <!-- Actions Column -->
            <div class="dui-actions-wrapper">
                <div class="dui-actions">
                    {{#each this.actions}}
                        <div class="dui-action-group {{#if this.isBonusMove}}dui-bonus-move{{/if}} {{#if this.selected}}active{{/if}}">
                            <div class="dui-action-head">
                                <button type="button" class="dui-action-btn dui-action-add" data-action="addAction" data-actor-id="{{../actorId}}" data-action-key="{{this.key}}" {{#unless ../canInteract}}disabled{{/unless}} title="{{localize 'DHQA.DowntimeUi.AddAction' label=this.label}}">
                                    {{#if this.isBonusMove}}<i class="fas fa-leaf"></i> {{/if}}{{this.label}}
                                </button>
                                {{#if this.count}}
                                <span class="dui-action-count">×{{this.count}}</span>
                                <button type="button" class="dui-action-remove" data-action="removeAction" data-actor-id="{{../actorId}}" data-action-key="{{this.key}}" {{#unless ../canInteract}}disabled{{/unless}} title="{{localize 'DHQA.DowntimeUi.RemoveOneAction' label=this.label}}">−</button>
                                {{/if}}
                            </div>

                            {{#if this.hasTarget}}
                                {{#each this.instances}}
                                <div class="dui-action-instance {{#if this.isEfficientSlot}}efficient{{/if}} {{#if this.isRecoverySlot}}recovery{{/if}} {{#if this.isRecoveryGrantedSlot}}recovery-granted{{/if}}">
                                    <select class="dui-target-select" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}}>
                                        {{#each ../../targetOptions}}
                                        <option value="{{this.id}}" {{#if (eq this.id ../targetActorId)}}selected{{/if}}>{{this.name}}</option>
                                        {{/each}}
                                    </select>
                                    {{#if this.canBeEfficientSlot}}
                                    <button type="button" class="dui-efficient-badge {{#if this.isEfficientSlot}}active{{/if}}" data-action="toggleEfficientSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isEfficientSlot}}{{localize 'DHQA.DowntimeUi.RemoveEfficientSlot'}}{{else}}{{localize 'DHQA.DowntimeUi.UseEfficientSlot'}}{{/if}}">
                                        <i class="fas fa-star"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeRecoverySlot}}
                                    <button type="button" class="dui-recovery-badge {{#if this.isRecoverySlot}}active{{/if}}" data-action="toggleRecoverySlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isRecoverySlot}}{{localize 'DHQA.DowntimeUi.RemoveRecoverySlot'}}{{else}}{{localize 'DHQA.DowntimeUi.UseRecoverySlot'}}{{/if}}">
                                        <i class="fas fa-redo"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeRecoveryGrantedSlot}}
                                    <button type="button" class="dui-recovery-granted-badge {{#if this.isRecoveryGrantedSlot}}active{{/if}}" data-action="toggleRecoveryGrantedSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isRecoveryGrantedSlot}}{{localize 'DHQA.DowntimeUi.RemoveRecoveryGrantSlot'}}{{else}}{{localize 'DHQA.DowntimeUi.UseRecoveryGrantSlot'}}{{/if}}">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeOasisSlot}}
                                    <button type="button" class="dui-oasis-badge {{#if this.isOasisSlot}}active{{/if}}" data-action="toggleOasisSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isOasisSlot}}{{localize 'DHQA.DowntimeUi.RemoveOasisReroll'}}{{else}}{{localize 'DHQA.DowntimeUi.UseOasisReroll'}}{{/if}}">
                                        <i class="fas fa-tint"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeOasisGrantedSlot}}
                                    <button type="button" class="dui-oasis-granted-badge {{#if this.isOasisGrantedSlot}}active{{/if}}" data-action="toggleOasisGrantedSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isOasisGrantedSlot}}{{localize 'DHQA.DowntimeUi.RemoveAllyOasisReroll'}}{{else}}{{localize 'DHQA.DowntimeUi.UseAllyOasisReroll'}}{{/if}}">
                                        <i class="fas fa-hand-holding-water"></i>
                                    </button>
                                    {{/if}}
                                </div>
                                {{/each}}
                            {{else if this.isForagerMove}}
                                {{#if this.count}}
                                <select class="dui-forager-select" data-actor-id="{{../actorId}}" {{#unless ../canInteract}}disabled{{/unless}} title="{{localize 'DHQA.DowntimeUi.YourChoiceIfYouRoll'}}">
                                    {{#each ../../foragerOptions}}
                                    <option value="{{this.value}}" {{#if (eq this.value ../../foragerChoice)}}selected{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </select>
                                {{/if}}
                            {{else if this.hasSlots}}
                                {{#each this.instances}}
                                <div class="dui-action-instance {{#if this.isEfficientSlot}}efficient{{/if}} {{#if this.isRecoverySlot}}recovery{{/if}} {{#if this.isRecoveryGrantedSlot}}recovery-granted{{/if}}">
                                    {{#if this.canBeEfficientSlot}}
                                    <button type="button" class="dui-efficient-badge {{#if this.isEfficientSlot}}active{{/if}}" data-action="toggleEfficientSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isEfficientSlot}}{{localize 'DHQA.DowntimeUi.RemoveEfficientSlot'}}{{else}}{{localize 'DHQA.DowntimeUi.UseEfficientSlot'}}{{/if}}">
                                        <i class="fas fa-star"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeRecoverySlot}}
                                    <button type="button" class="dui-recovery-badge {{#if this.isRecoverySlot}}active{{/if}}" data-action="toggleRecoverySlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isRecoverySlot}}{{localize 'DHQA.DowntimeUi.RemoveRecoverySlot'}}{{else}}{{localize 'DHQA.DowntimeUi.UseRecoverySlot'}}{{/if}}">
                                        <i class="fas fa-redo"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeRecoveryGrantedSlot}}
                                    <button type="button" class="dui-recovery-granted-badge {{#if this.isRecoveryGrantedSlot}}active{{/if}}" data-action="toggleRecoveryGrantedSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isRecoveryGrantedSlot}}{{localize 'DHQA.DowntimeUi.RemoveRecoveryGrantSlot'}}{{else}}{{localize 'DHQA.DowntimeUi.UseRecoveryGrantSlot'}}{{/if}}">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeOasisSlot}}
                                    <button type="button" class="dui-oasis-badge {{#if this.isOasisSlot}}active{{/if}}" data-action="toggleOasisSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isOasisSlot}}{{localize 'DHQA.DowntimeUi.RemoveOasisReroll'}}{{else}}{{localize 'DHQA.DowntimeUi.UseOasisReroll'}}{{/if}}">
                                        <i class="fas fa-tint"></i>
                                    </button>
                                    {{/if}}
                                    {{#if this.canBeOasisGrantedSlot}}
                                    <button type="button" class="dui-oasis-granted-badge {{#if this.isOasisGrantedSlot}}active{{/if}}" data-action="toggleOasisGrantedSlot" data-actor-id="{{../../actorId}}" data-instance-id="{{this.id}}" {{#unless ../../canInteract}}disabled{{/unless}} title="{{#if this.isOasisGrantedSlot}}{{localize 'DHQA.DowntimeUi.RemoveAllyOasisReroll'}}{{else}}{{localize 'DHQA.DowntimeUi.UseAllyOasisReroll'}}{{/if}}">
                                        <i class="fas fa-hand-holding-water"></i>
                                    </button>
                                    {{/if}}
                                </div>
                                {{/each}}
                            {{/if}}
                        </div>
                    {{/each}}
                </div>
            </div>

            <!-- Feature rows below moves list -->
            {{#if this.showFeaturesRow}}
            <div class="dui-features-row">
                {{#if this.hasEloquent}}
                <div class="dui-eloquent-selector-below">
                    <span class="dui-eloquent-label">{{localize "DHQA.DowntimeUi.Eloquent"}}</span>
                    <select class="dui-eloquent-select" data-actor-id="{{this.actorId}}" {{#unless this.canInteract}}disabled{{/unless}} title="{{localize 'DHQA.DowntimeUi.EloquentGrantBonusMoveTo'}}">
                        <option value="">{{localize "DHQA.DowntimeUi.ChooseAFriend"}}</option>
                        {{#each this.eloquentOptions}}
                        {{#if this.id}}
                        <option value="{{this.id}}" {{#if (eq this.id ../eloquentBeneficiary)}}selected{{/if}}>→ {{this.name}}</option>
                        {{/if}}
                        {{/each}}
                    </select>
                </div>
                {{/if}}

                {{#if this.hasEfficient}}{{#if ../isShort}}
                <div class="dui-efficient-indicator">
                    <i class="fas fa-star"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.Efficient"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.CanUpgradeOneActionTo"}}</span>
                </div>
                {{/if}}{{/if}}

                {{#if this.hasRecovery}}{{#if ../isShort}}
                <div class="dui-recovery-selector">
                    <div class="dui-efficient-indicator dui-recovery-indicator">
                        <i class="fas fa-redo"></i>
                        <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.Recovery"}}</span>
                        <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.CanUpgradeOneActionTo"}}</span>
                    </div>
                    {{#if this.canSelectRecoveryAlly}}
                    <select class="dui-recovery-beneficiary-select" data-actor-id="{{this.actorId}}" {{#unless this.canInteract}}disabled{{/unless}} title="{{localize 'DHQA.DowntimeUi.Spend1HopeToGrant'}}">
                        <option value="">{{localize "DHQA.DowntimeUi.GrantAllyCosts1Hope"}}</option>
                        {{#each this.recoveryAllyOptions}}
                        <option value="{{this.id}}" {{#if (eq this.id ../recoveryBeneficiary)}}selected{{/if}}>→ {{this.name}}</option>
                        {{/each}}
                    </select>
                    {{else}}
                    <span class="dui-recovery-no-hope" title="{{localize 'DHQA.DowntimeUi.NeedAtLeast1Hope'}}">{{localize "DHQA.DowntimeUi.NoHopeToGrant"}}</span>
                    {{/if}}
                </div>
                {{/if}}{{/if}}

                {{#if this.hasOasis}}{{#if ../isShort}}
                <div class="dui-recovery-selector">
                    <div class="dui-efficient-indicator dui-oasis-indicator">
                        <i class="fas fa-tint"></i>
                        <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.Oasis"}}</span>
                        <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.RerollOneDowntimeMoveDie"}}</span>
                    </div>
                    <select class="dui-oasis-beneficiary-select" data-actor-id="{{this.actorId}}" {{#unless this.canInteract}}disabled{{/unless}} title="{{localize 'DHQA.DowntimeUi.GiveYourOasisRerollTo'}}">
                        <option value="">{{localize "DHQA.DowntimeUi.KeepTheReroll"}}</option>
                        {{#each this.oasisAllyOptions}}
                        <option value="{{this.id}}" {{#if (eq this.id ../oasisBeneficiary)}}selected{{/if}}>&rarr; {{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                {{/if}}{{/if}}

                {{#if this.hasOasisGrant}}{{#if ../isShort}}
                <div class="dui-efficient-indicator dui-oasis-grant-indicator">
                    <i class="fas fa-hand-holding-water"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.OasisGranted"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.AnAllyGaveYouTheir"}}</span>
                </div>
                {{/if}}{{/if}}

                {{#if this.hasTimekeepersPendant}}
                <div class="dui-efficient-indicator dui-timekeeper-indicator">
                    <i class="fas fa-hourglass-half"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.TimekeeperSPendant"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.1DowntimeMoveEachRest"}}</span>
                </div>
                {{/if}}

                {{#if this.hasPipeweed}}
                <div class="dui-efficient-indicator dui-pipeweed-indicator">
                    <i class="fas fa-cannabis"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.Pipeweed"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.SmokeItAlongsideClearStress"}}</span>
                </div>
                {{/if}}

                {{#if this.hasRecoveryGrant}}{{#if ../isShort}}
                <div class="dui-efficient-indicator dui-recovery-grant-indicator">
                    <i class="fas fa-heart"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.RecoveryGranted"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.AllySpentHope"}}{{#unless this.grantorHasHope}} {{localize "DHQA.DowntimeUi.NoLongerHasHope"}}{{/unless}}</span>
                </div>
                {{/if}}{{/if}}

                {{#if this.hasSoothingSpeech}}
                <div class="dui-efficient-indicator">
                    <i class="fas fa-comment-medical"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.SoothingSpeech"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.TendToWoundsOnAnother"}}</span>
                </div>
                {{/if}}

                {{#if this.hasArmorer}}
                <div class="dui-efficient-indicator">
                    <i class="fas fa-shield-alt"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.Armorer"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.WhenYouRepairArmorAll"}}</span>
                </div>
                {{/if}}

                {{#if this.hasSelfHealingArmor}}
                <div class="dui-efficient-indicator dui-selfhealing-indicator">
                    <i class="fas fa-shield-heart"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.SelfHealing"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.WornArmourClears1Armor"}}</span>
                </div>
                {{/if}}

                {{#if this.hasPremiumBedroll}}
                <div class="dui-efficient-indicator">
                    <i class="fas fa-bed"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.PremiumBedroll"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.DuringDowntimeAutomaticallyClear1"}}</span>
                </div>
                {{/if}}

                {{#if this.hasCelestialTrance}}
                <div class="dui-efficient-indicator">
                    <i class="fas fa-moon"></i>
                    <span class="dui-efficient-text">{{localize "DHQA.DowntimeUi.CelestialTrance"}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.Grants1ExtraMoveDuring"}}</span>
                </div>
                {{/if}}

                {{#if this.hasBeastbound}}
                <div class="dui-efficient-indicator">
                    <i class="fas fa-paw"></i>
                    <span class="dui-efficient-text">Beastbound {{#if this.beastboundInfo}}({{#if this.beastboundInfo.found}}{{this.beastboundInfo.name}}{{else}}{{localize "DHQA.DowntimeUi.NotFound"}}{{/if}}){{/if}}</span>
                    <span class="dui-efficient-tooltip">{{localize "DHQA.DowntimeUi.IfYouChooseADowntime"}}</span>
                </div>
                {{/if}}
            </div>
            {{/if}}

            <!-- Counter Column -->
            <div class="dui-counter">
                <span class="dui-count-label">{{localize "DHQA.DowntimeUi.Moves"}}</span>
                <span class="dui-count-val" {{#if this.isOverLimit}}style="color: #ff6b6b;"{{/if}}>{{this.selectedCount}}/{{this.maxChoices}}</span>
            </div>

        </div>
        {{else}}
        <div class="dui-empty">
            <i class="fas fa-users-slash"></i>
            <p>{{localize "DHQA.DowntimeUi.NoPlayersFound"}}</p>
        </div>
        {{/each}}
    </div>

</div>