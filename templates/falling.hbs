<div class="falling-content standard-form">
    <p class="notes" style="margin-bottom: 10px;">{{localize "DH_QUICKACTIONS.FALLING.prompt"}}</p>
    
    <div class="falling-buttons">
        <!-- 
           Direct buttons that activate the 'rollDamage' action.
           Each passes the correct value via 'data-height'.
        -->
        
        <button type="button" class="fall-btn" data-action="rollDamage" data-height="veryclose">
            <span class="label">{{localize "DAGGERHEART.CONFIG.fallAndCollision.veryClose.label"}}</span>
            <span class="formula">{{formulas.veryclose}}</span>
        </button>

        <button type="button" class="fall-btn" data-action="rollDamage" data-height="close">
            <span class="label">{{localize "DAGGERHEART.CONFIG.fallAndCollision.close.label"}}</span>
            <span class="formula">{{formulas.close}}</span>
        </button>

        <button type="button" class="fall-btn" data-action="rollDamage" data-height="far">
            <span class="label">{{localize "DH_QUICKACTIONS.FALLING.farVeryFar"}}</span>
            <span class="formula">{{formulas.far}}</span>
        </button>

        <button type="button" class="fall-btn" data-action="rollDamage" data-height="collision">
            <span class="label">{{localize "DAGGERHEART.CONFIG.fallAndCollision.collision.label"}}</span>
            <span class="formula">{{formulas.collision}}</span>
        </button>
    </div>
    
    <div class="form-footer" style="margin-top: 15px;">
        <button type="button" data-action="cancel" class="dh-btn" style="width: 100%;">
            <i class="fas fa-times"></i> {{localize "DH_QUICKACTIONS.COMMON.cancel"}}
        </button>
    </div>
</div>